{"schema": "P106B_RESIDUAL_HOLD_INVENTORY_V1", "counts": {"documents": 460695, "input_ids": 462874291}, "unique_original_texts": 297539, "first_reasons": {"SOURCE_BOUNDARY_NOT_RECOVERABLE": 3, "APPENDIX_CATEGORY_BOUNDARY_REQUIRES_CONTEXT": 194018, "UNRESOLVED_FIELD_OR_TITLE": 134972, "MAIN_BODY_REPETITION_REQUIRES_CONTEXT": 64583, "BROKEN_TABLE_OR_WIKI_MARKUP": 10942, "AMBIGUOUS_STRUCTURE_LABEL_REQUIRES_CONTEXT": 30550, "MARKUP_OR_TRANSCRIPTION_REQUIRES_CONTEXT": 7667, "NONBODY_UI_REQUIRES_CONTEXT_EDIT": 4243, "UNRESOLVED_RAW_TABLE_OR_CLOSING_WIKI_MARKUP": 1407, "POPULATED_NAVIGATION_REQUIRES_CONTEXT_EDIT": 3192, "INDEPENDENT_PROSE_NOT_ESTABLISHED": 2914, "INTERNAL_BIRTH_YEAR_CONFLICT_UNRESOLVED": 678, "INHERITED_INDIVIDUAL_HOLD_REQUIRES_SOURCE_SHA_REVIEW": 3487, "MISSING_EXPRESSION_OR_STRAY_FRAGMENT": 1939, "\uc5f0\ud638\u00b7\uae30\ub144\u00b7\uc0ac\uac74\u00b7\ud0c4\uc0dd\u00b7\uc0ac\ub9dd \ubaa9\ub85d\uc740 \uc788\uc73c\ub098 \uc774 \uc790\ub8cc\ub97c \uace0\uc815\ud560 \uc5f0\ub3c4 \uc81c\ubaa9\uc774\ub098 \uc5f0\ub3c4\uac00 \uc5c6\ub2e4. \uc5f0\ud638 \uac12\ub9cc\uc73c\ub85c \uc808\ub300 \uc5f0\ub3c4\ub97c \ucd94\uc815\ud558\uc9c0 \uc54a\uc558\ub2e4.": 2, "OPEN_ACTUAL_CODE_FENCE": 11, "\uc6d0\ubb38\u00b7\uc81c\uc548\ubb38\uc740 \ub3d9\uc77c\ud558\ub2e4. \ub17c\ubb38\uc740 \ub3c5\ub9bd\uc801\uc778 \ud559\uc220 \uae00\uc774\uace0 \ucc38\uace0\ubb38\ud5cc\u00b7\uc778\uc6a9\u00b7\uc800\uc790 \uac10\uc0ac \ubb38\uad6c\ub3c4 \ubcf4\uc874\ud574\uc57c \ud558\uc9c0\ub9cc, \ub3c4\uc785\ubd80\uc758 `(or )`, \ubc18\ubcf5\ub418\ub294 \ube48 \uae30\ud638\u00b7\ubcc0\uc218, `and` \uc55e\ub4a4\uc5d0 \ube44\uc5b4 \uc788\ub294 \uc218\uc2dd\uc774 Markov chain\u00b7\uadf8\ub798\ud504 \ubd84\ud560 \uc815\uc758\uc640 \uacb0\uacfc\uc5d0 \uac78\uccd0 \ub098\ud0c0\ub09c\ub2e4. \uc774 \ud575\uc2ec \uc218\uc2dd\u00b7\ub9e4\uac1c\ubcc0\uc218 \uc5c6\uc774\ub294 \uc124\uba85\uc758 \uc758\ubbf8\ub97c \ud655\uc815\ud560 \uc218 \uc5c6\uc5b4 \ubcf4\ub958\ud55c\ub2e4.": 2, "388\uc758 \uc815\uc758\uc640 \uc57d\uc218 \ubaa9\ub85d, \uc5f0\ub3c4 \ud45c\uae30\ub294 \ub3c5\ub9bd \ub0b4\uc6a9\uc73c\ub85c \uc77d\ud78c\ub2e4. \ud558\uc9c0\ub9cc \ub05d\uc758 `3e02 388`\uc774 \ubcf8\ubb38 \uc218\uc2dd\u00b7\ubcc4\uce6d\u00b7\uc794\uc5ec \uc870\uac01 \uc911 \ubb34\uc5c7\uc778\uc9c0 \uc54c \uc218 \uc5c6\uace0 `\uacfc\ud559` \ud45c\uc81c\ub3c4 \ube44\uc5b4 \uc788\ub2e4. \uc774\ub97c 388\uc758 \uacfc\ud559\uc801 \ud45c\uae30\ub77c\uace0 \ub2e8\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "\uacc4\ucc28\uc218\uc5f4 \uc815\uc758\u00b7\uc608\u00b7\uc131\uc9c8 \uc804\ubc18\uc5d0\uc11c \uc218\uc5f4 \uae30\ud638\uc640 \uc218\uc2dd \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4. \uc608\ub97c \ub4e4\uc5b4 `\uc218\uc5f4` \ub2e4\uc74c \uc785\ub825, \uc77c\ubc18\ud56d, \ub2e8\uc870\uc131\uc758 \ud544\uc694\ucda9\ubd84\uc870\uac74, \uace0\uacc4 \ub4f1\ucc28\uc218\uc5f4\uc758 \ucc28\uc218 \ud45c\uae30\uac00 \ub204\ub77d\ub418\uc5b4 \uc218\ud559\uc801 \uad00\uacc4\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4. \ucc38\uace0 \ud56d\ubaa9\uacfc \ubaa9\ub85d\uc740 \ubcf4\uc874\ud558\ub418 \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "Basic VML Types\ub77c\ub294 \uc8fc\uc81c\uc640 \uc5ec\ub7ec \uc124\uba85\uc740 \uc77d\ud788\uc9c0\ub9cc \uc720\ud615\ud45c\uc640 \uc0c9\uc0c1 \ud1a0\ud070 \ud45c\uc758 \ud544\ub4dc \uc5f0\uacb0\uc774 \ube44\uace0 \uc218\uc2dd\u00b7\ud0dc\uadf8 \uacbd\uacc4\uac00 \uc190\uc0c1\ub418\uc5b4 \ud575\uc2ec \uc815\uc758\ub97c \uc548\uc804\ud558\uac8c \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4. \uc548\uc804\ud55c \uc644\uacb0 \ubcf8\ubb38 \uacbd\uacc4\ub97c \uc7a1\uae30 \uc5b4\ub824\uc6cc \uc804\uccb4 \ubcf4\ub958\ud558\uace0 \uc608\uc2dc\ub97c hold \ud30c\uc77c\uc5d0 \uc801\uc5c8\ub2e4.": 2, "\ubc18\uc751\ud615 \uae00\uc790 \ud06c\uae30\uc5d0 \ub300\ud55c \uc124\uba85\uc740 \ub3c5\ub9bd\ub41c \uae30\uc220 \uae00\uc774\uc9c0\ub9cc, \u201c\ucf54\ub4dc\ub294 \ub2e4\uc74c\uacfc \uac19\ub2e4\u201d, \u201c\uc774 \ud568\uc218\u201d, \u201c\ub610 \ub2e4\ub978 \uc608\u201d, \u201c\uc815\ub9ac\ud558\uba74\u201d \ub4a4\uc5d0 \uc124\uba85\uc774 \uac00\ub9ac\ud0a4\ub294 \ucf54\ub4dc \uc608\uc81c\uac00 \uc5c6\ub2e4. \ub204\ub77d\ub41c Sass/CSS \uc608\uc81c\ub97c \uc0dd\uc131\ud560 \uc218 \uc5c6\uace0, \uadf8 \ubb38\uc7a5\ub4e4\uc744 \uc0ad\uc81c\ud558\uba74 \uc124\uba85 \uad00\uacc4\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\ub2e4. \uad00\ub828 \uc218\uce58\u00b7\ub2e8\uc704\u00b7HTML \uc694\uc18c\u00b7\uc6a9\uc5b4\ub294 \ubcf4\uc874\ud558\uace0 \ub204\ub77d \uad6c\uac04\ub9cc \ubcf4\ub958\ud55c\ub2e4.": 2, "\uc81c\ubaa9\uacfc 2010~2012 \uc5f0\ub3c4 \ud45c\uc81c, \uad00\ub828 \ub9c1\ud06c\ub9cc \uc788\uace0 \uc870\uc120\ubbfc\uc8fc\uc8fc\uc758\uc778\ubbfc\uacf5\ud654\uad6d \ucd95\uad6c \uad6d\uac00\ub300\ud45c\ud300 \uacbd\uae30 \uacb0\uacfc\uac00 \uc5c6\ub2e4. \ub9c1\ud06c\ub9cc\uc73c\ub85c \uacb0\uacfc\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4.": 2, "\uc218\ud559 \uc18c\uac1c\u00b7\uc2dc\ud5d8\u00b7ACCA \ud64d\ubcf4\uc131 \ubb38\uad6c\uac00 \ud55c \ubb38\uc7a5 \ud750\ub984 \uc548\uc5d0 \uc11e\uc774\uace0 \uc22b\uc790\uc640 \ub17c\uc9c0\uc758 \uacbd\uacc4\uac00 \ub04a\uaca8 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud560 \uc218 \uc5c6\uc74c.": 2, "K\ud31d\uc2a4\ud0c0 \ubc29\uc1a1 \uacb0\uacfc \ud45c\uc758 \uc704\ud0a4 \ud14c\uc774\ube14 \uad6c\uc870\uac00 \uae68\uc838 \uc788\ub2e4. \ud2b9\ud788 \ud328\uc790\ubd80\ud65c\uc804 \ubd80\ubd84\uc758 `\uc0dd\ubc29\uc1a1 \uc9c4\ucd9c|-` \ub4f1 \ud589 \uacbd\uacc4\uac00 \ubd99\uc5b4 \uc788\uace0, \uc5f4\ubcc4 \uacb0\uacfc\u00b7\ud2b9\uc774\uc0ac\ud56d \uc140 \uad00\uacc4\uac00 \ubd88\uba85\ud655\ud558\ub2e4. \ud45c\uc758 \ud589\u00b7\uc774\ub984\u00b7\uace1\u00b7\uc18c\uc18d\uc0ac\u00b7\uc21c\uc704\ub97c \uc7ac\ubc30\uce58\ud558\uac70\ub098 \uace0\uce58\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\ubcc0 \uc124\uba85\uacfc \uc218\uce58\ub294 \ubcf4\uc874\ud55c\ub2e4.": 2, "\ub85c\uadf8\ub7ad\ud06c \uac80\uc815 \uc124\uba85\uc740 \uc8fc\uc81c\uac00 \uba85\ud655\ud558\uc9c0\ub9cc, \uc704\ud5d8\uc9d1\ub2e8\u00b7\uc0ac\uac74 \uc218\uc758 \uae30\ud638, \uae30\ub313\uac12\u00b7\ubd84\uc0b0, \uac80\uc815\ud1b5\uacc4\ub7c9, \uc815\uaddc\uadfc\uc0ac\uc640 \ud45c\ubcf8\uc218 \uacc4\uc0b0\uc758 \ud575\uc2ec \uc218\uc2dd \uc790\ub9ac\uac00 \ub2e4\uc218 \ube44\uc5b4 \uc788\ub2e4. \uc11c\uc9c0\uc640 \uac1c\ub150 \uc124\uba85\uc740 \ub530\ub85c \ubcf4\uc874\ud560 \uc218 \uc788\uc73c\ub098 \uc218\uc2dd\uc758 \uad00\uacc4\ub97c \ubcf5\uad6c\ud55c \uc644\uacb0 \ud1b5\uacc4 \uc124\uba85\uc73c\ub85c \ucde8\uae09\ud560 \uc218 \uc5c6\ub2e4. \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "\uc6d0\ubb38 \uc804\uccb4\uac00 ParaPro \ud50c\ub798\uc2dc\uce74\ub4dc \uc11c\ube44\uc2a4 \ud64d\ubcf4\u00b7\uac00\uc785/\ub2e4\uc6b4\ub85c\ub4dc \uc548\ub0b4\u00b7\ud6c4\uae30 \uc694\uccad\uc774\ub2e4. \uc2e4\uc81c \ud559\uc2b5 \uce74\ub4dc\u00b7\uc138\ud2b8\u00b7\ubb38\ud56d\u00b7\ub2f5\ubcc0\uc774 \uc5c6\uc5b4 \uad50\uc721 \ubcf8\ubb38\uc73c\ub85c \uc62c\ub9b4 \ub3c5\ub9bd\uc801\uc778 \ud559\uc2b5 \ub0b4\uc6a9\uc774 \uc5c6\ub2e4. \uc6d0\ubb38 \uc804\uccb4\ub97c \ubcf4\ub958 \uae30\ub85d\uc5d0 \uadf8\ub300\ub85c \ubcf4\uc874\ud588\ub2e4.": 2, "\ube48 `External links` \ud45c\uc81c\ub97c \uc81c\uac70\ud55c \ubcc0\uacbd \uc790\uccb4\ub294 \uc548\uc804\ud558\ub2e4. \ub2e4\ub9cc \ubcf8\ubb38 `electron densities \u2013 cm and pressures \u2013 K cm`\uc5d0\uc11c \ubc00\ub3c4\u00b7\uc555\ub825 \ud45c\ud604\uc774 \ube44\uc5b4 \uc788\uc5b4 \ubb3c\ub9ac \uc124\uba85\uc774 \uc190\uc0c1\ub3fc \uc788\ub2e4. \uc5c6\ub294 \uc2dd\u00b7\uac12\uc740 \ucd94\uc815\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc774 \uc190\uc0c1 \uad6c\uac04\uc744 \ubcf4\ub958\ud55c\ub2e4. \uc815\uc0c1 \uc11c\uc9c0 \ud56d\ubaa9\uc740 \uc804\ubd80 \ubcf4\uc874\ud55c\ub2e4.": 2, "\uc774 \uc790\ub8cc\ub294 \uc11c\ub85c \ub2e4\ub978 \ubc88\ud638 \uccb4\uacc4\ub85c \ub2e4\uc2dc \uc2dc\uc791\ud558\ub294 \uc6b4\uc728\u00b7\ud589\ubcc4 \ud559\uc220 \uc8fc\uc11d\ub9cc \ub2f4\uace0 \uc788\ub2e4. `this masque`, `this line`, `the manuscript` \ub4f1\uc740 \uc774\ub984\uacfc \uc6d0\ubb38 \uad6c\uc808\uc774 \uc5c6\ub294 \ub2e4\ub978 \ubb38\uc11c\uc5d0 \uc758\uc874\ud558\uba70, \ub450 \ubc88\uc9f8 `1 - 6` \ubb36\uc74c\ub3c4 \uc5b4\ub290 \uc791\ud488\uc778\uc9c0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc81c\ubaa9 \ubd80\uc7ac\ub9cc\uc774 \uc544\ub2c8\ub77c \uc8fc\uc11d\uc774 \ubd99\uc744 \uc6d0\ubb38\u00b7\uc791\ud488 \uacbd\uacc4\uac00 \uc190\uc2e4\ub418\uc5b4 \ub3c5\ub9bd\uc801\uc73c\ub85c \uadc0\uc18d\ud560 \uc218 \uc5c6\ub2e4. \uc8fc\uc11d\u00b7\uc6b4\uc728\u00b7\uc778\uc6a9 \uc790\uccb4\ub97c \ubc84\ub9ac\uc9c0 \ub9d0\uace0 \uc6d0\ubb38 \ub9e5\ub77d\uc744 \ud655\uc778\ud560 \ub54c\uae4c\uc9c0 \ubcf4\ub958\ud55c\ub2e4.": 2, "\uc778\ud130\ub137\u00b7\uac8c\uc784\u00b7\ud559\uc5c5 \uc131\uacfc\uc5d0 \uad00\ud55c \uc11c\ub85c \ub2e4\ub978 \ubb38\ub2e8, \ub04a\uae34 \uc778\uc6a9, \ucd9c\ucc98\u00b7\uc800\uc790 \uc815\ubcf4\uc640 \uc2ac\ub77c\uc774\ub4dc UI\uac00 \uc11e\uc600\ub2e4. \uc8fc\uc7a5\uacfc \uc778\uc6a9 \uc8fc\uccb4\uc758 \uacbd\uacc4\uac00 \uc18c\uc2e4\ub418\uc5b4 \ub3c5\ub9bd \ubb38\uc7a5\uc744 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud558\uae30 \uc5b4\ub835\ub2e4.": 2, "\ube14\ub85c\uadf8 \uc544\uce74\uc774\ube0c\uc5d0\uc11c \uc5ec\ub7ec \uae00 \uc870\uac01\uacfc Tag Archives\u00b7\ub313\uae00\u00b7\ud0dc\uadf8\uac00 \uad50\ucc28\ud55c\ub2e4. \uc81c\ubaa9\u00b7\uac8c\uc2dc\ubb3c \uacbd\uacc4\uac00 \ubd80\uc871\ud574 \uac1c\ubcc4 \uae00\ub85c \uc790\ub974\uba74 \uc778\uc6a9\u00b7\uacac\ud574 \uadc0\uc18d\uc744 \ucd94\uc815\ud558\uac8c \ub418\uc5b4 \uc0c8 \ubcf8\ubb38\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 2, "OBSERVED_PAGE_WIDGET_REQUIRES_CONTEXT_EDIT": 44, "\ud574\ube59\u00b7\uadf8\ub9b0\ub780\ub4dc \uc721\ube59\u00b7\ub2ec \ud06c\uae30 \ubc14\uc704 \uad00\ub828 \uc124\uba85\uc740 \uc77c\ubd80 \ub0a8\uc9c0\ub9cc \uc9c8\ubb38 \ub300\uc0c1\uacfc \uc55e\ub4a4 \ubb38\ub9e5\uc774 \uc5c6\ub2e4. PerlMonks \uac8c\uc2dc \uc548\ub0b4\u00b7HTML \uc9c0\uce68\uacfc \ud0d0\uc0c9 UI\ub3c4 \ubcf8\ubb38\uc5d0 \uc11e\uc5ec \uc788\ub2e4. \ub2f5\ubcc0 \ubc94\uc704\uc640 UI \uc81c\uac70\uc120\uc744 \ud14d\uc2a4\ud2b8\ub9cc\uc73c\ub85c \ud655\uc815\ud558\uae30 \uc5b4\ub835\ub2e4.": 1, "\uae30\uc0ac \uacbd\uacc4\uc640 \ubb38\uc7a5 \uc5f0\uacb0\uc774 \uc190\uc0c1\ub41c \uc0c1\ud0dc\uc5d0 \uc0dd\ubb3c\ubb34\uae30 \uc900\ube44\u00b7\ud655\uc0b0\uc758 \uc815\ub7c9 \uae30\uc220 \ub0b4\uc6a9\uc774 \uc11e\uc5ec \uc788\ub2e4. \ub3c5\ub9bd \ubcf8\ubb38\uc744 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc558\uace0 \uc0c8 \ubcf8\ubb38\uc774\ub098 \ubcf5\uc0ac \ubd80\ub85d\ub3c4 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 1, "\ud558\uc774\ud401 \uc5ed\uc774 1910\ub144\uc5d0 \ud611\uada4\uc5ed\uc73c\ub85c \uac1c\uc5c5\ud588\ub2e4\ub294 \uc18c\uac1c\uc640, 1902\ub144 6\uc6d4 16\uc77c \ucca0\ub3c4 \uc644\uacf5 \ubc0f \uc5ed \uac1c\uc5c5\uc774\ub77c\ub294 \uc5f0\ud601\uc774 \ud568\uaed8 \uc788\uc5b4 \ub0a0\uc9dc\uac00 \ucda9\ub3cc\ud55c\ub2e4. source SHA \ubc0f \uc678\ubd80 \uc790\ub8cc\ub97c \ud655\uc778\ud560 \uc218 \uc5c6\uace0 \uc804\ud6c4 \uc5ed \uc808\ub3c4 \ube44\uc5b4 \uc788\uc5b4 \ucda9\ub3cc\uc744 \uc784\uc758\ub85c \uc815\uaddc\ud654\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uc5ec\ub7ec \uc9e7\uc740 \ub300\uc0ac\u00b7\uc81c\ubaa9\uacfc \uac01 `Tags:` \ud56d\ubaa9\uc774 \uc774\uc5b4\uc9c0\uc9c0\ub9cc, \uadf8\uac83\ub4e4\uc774 \uc5b4\ub5a4 \uc791\ud488\u00b7\uc0c1\ud669\uc5d0 \uc18d\ud558\ub294\uc9c0 \ubcf8\ubb38\uc5d0\uc11c \uc2dd\ubcc4\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38\uacfc \uc81c\uc548\ubb38\uc740 \uac19\uace0 \uc0ad\uc81c \uc190\uc2e4\uc740 \uc5c6\uc73c\ub098, \uc804\uccb4\ub97c \ub3c5\ub9bd\uc801\uc778 \uc0b0\ubb38\uc73c\ub85c \ud655\uc815\ud560 \uadfc\uac70\ub3c4 \uc5c6\ub2e4. \ub300\uc0ac\u00b7\ud0dc\uadf8\ub97c \uc784\uc758\ub85c \uc9dd\uc9d3\uac70\ub098 \ubb38\ub9e5\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uad00\uacc4 \ub300\uc218\uc758 \ud575\uc2ec \uae30\ud638\u00b7\uc815\uc758\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \uc18c\uc2e4\ub418\uace0 SQL \uc608\ub9cc\uc73c\ub85c \uc6d0\ub798 \uad00\uacc4\ub97c \ubcf5\uad6c\ud560 \uadfc\uac70\uac00 \ubd80\uc871\ud568. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "\ubcf8\ubb38\uc740 \ubd80\ub098 \uc0ac\ub974\uc758 \uc0dd\ub144\uc6d4\uc77c\uc744 1992\ub144 1\uc6d4 31\uc77c\ub85c \uc801\uc9c0\ub9cc \ubd84\ub958\uc5d0\ub294 1991\ub144 \ucd9c\uc0dd\uc774 \uc788\uc5b4 \ub0b4\ubd80 \uc5f0\ub3c4\uac00 \ucda9\ub3cc\ud55c\ub2e4. \uc678\ubd80 \ud655\uc778\uc774\ub098 \uc784\uc758 \uc815\uc815\uc744 \ud558\uc9c0 \uc54a\uc558\uc73c\ubbc0\ub85c \uc6d0\ubb38 \uadf8\ub300\ub85c KEEP\ud558\ub294 \uc81c\uc548\uc744 \ubb34\uc870\uac74 \ud1b5\uacfc\uc2dc\ud0ac \uc218 \uc5c6\ub2e4.": 1, "\ud558\uae30\uc640\ub77c\uc815 \uc18c\uac1c\u00b7\uc9c0\ub9ac\u00b7\uc5ed\uc0ac\u00b7\ucca0\ub3c4\u00b7\ub3c4\ub85c \uc815\ubcf4\ub294 \ub300\ubd80\ubd84 \uc77d\ud788\uc9c0\ub9cc, \uc5ed\uc0ac \uc55e\uc758 \uc5f4\ub9b0 \ucf54\ub4dc \ud39c\uc2a4 \ud45c\uc2dd\uc774 \ub0a8\uc544 \uc788\uace0 \ud569\ubcd1\uc77c\uc774 \uc18c\uac1c\uc5d0\ub294 2004-04-01, \uc5ed\uc0ac\uc5d0\ub294 2004-03-01\ub85c \uc11c\ub85c \ub2e4\ub974\ub2e4. \ub450 \ub0a0\uc9dc\ub97c \ub2e8\uc77c \uac12\uc73c\ub85c \ubc14\uafb8\uac70\ub098 \uc5f4\ub9b0 \ud45c\uc2dd\uc744 \uc784\uc758 \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4.": 1, "\ube44\uad50\u00b7\ub300\uc870 \uae00\uc4f0\uae30 \uc548\ub0b4\ub294 \uc628\uc804\ud55c \ub3c5\ub9bd \ub2f5\ubcc0\uc774\ub2e4. \ub2e4\ub9cc \u201c~~~2A. detail 1\u201d \ub4f1 \uc904\uc740 \uac1c\uc694 \ud45c\uae30\ucc98\ub7fc \uc77d\ud788\ub294 \ub3d9\uc2dc\uc5d0 \ub2eb\ub294 \uc904\uc774 \uc5c6\ub294 \uc2e4\uc81c Markdown \ud39c\uc2a4 \uad6c\ubb38\uc774\ub2e4. \uc758\ub3c4\ub41c \ud45c\uae30\uc778\uc9c0 \uc190\uc0c1\ub41c \ud39c\uc2a4\uc778\uc9c0 \uc6d0\ubb38\ub9cc\uc73c\ub85c \uc815\ud560 \uc218 \uc5c6\uc5b4 \uc0ad\uc81c\u00b7\uc7ac\ubc30\uce58\u00b7\uc885\uacb0\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub05d\uc758 \ubbf8\uad6d\uc0ac \uc9c8\ubb38 \ubaa9\ub85d\ub3c4 \uacbd\uacc4 \ud45c\uc81c\uac00 \uc5c6\uc5b4 \uad00\ub828\ubb38\ud56d\uc778\uc9c0 \ubcc4\ub3c4 UI\uc778\uc9c0 \ubd88\ud655\uc815\uc774\ub2e4. \uc55e\uc758 \uc548\ub0b4\ubb38\uc740 \ub3c5\ub9bd \ubcf4\uc874 \uac00\ub2a5\ud558\ub2e4.": 1, "\uacbd\ub9e4/\ud310\ub9e4 \ud56d\ubaa9\uc5d0 \uc2e0\ubb38 \ubc1c\ucdcc, \uc0dd\ub7b5\ubd80\ud638, \ud310\ub9e4 \uc124\uba85, \uc885\uc774 \uc0c1\ud0dc\uac00 \uc11e\uc5ec \uc6d0\uc2e0\ubb38 \ub3c5\ub9bd \ubcf8\ubb38\uacfc \uc778\uc6a9 \uacbd\uacc4\ub97c \uad6c\ubd84\ud560 \uc218 \uc5c6\ub2e4. \ub0a0\uc9dc\u00b7\ud56d\ubaa9\ubc88\ud638\u00b7\uc778\uc6a9\uc740 \ubcf5\uc6d0\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "DFT\u00b7FFT, Blackman/Hann \ucc3d, \uc0c1\uad00\u00b7PSD\u00b7coherence \uad00\ub828 \ubcf8\ubb38\uacfc Matlab/Octave \ucf54\ub4dc \ubc0f \uc11c\uc9c0\ub294 \uc0c1\ub2f9 \ubd80\ubd84 \ubcf4\uc874\ub3fc \uc788\uc73c\ub098 \uc815\uc758\uc2dd\u00b7\ubcc0\uc218\u00b7\uc218\uce58\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube60\uc838 \ub4a4 \ubb38\uc7a5\uc774 \ube48 \uae30\ud638\ub97c \ucc38\uc870\ud55c\ub2e4. \ud398\uc774\uc9c0\u00b7\uadf8\ub9bc\uc744 \ubcf4\uc9c0 \uc54a\uace0 \uc218\uc2dd\uc774\ub098 \uc870\uac74\uc744 \ubcf5\uc6d0\ud560 \uc218 \uc5c6\uc5b4 \uc7a5 \uc804\uccb4\ub97c \uc815\uc0c1 \uae30\uc220 \uc124\uba85\uc73c\ub85c \ucc44\ud0dd\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc77d\uae30\ub9cc \ud588\uace0 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uc21c\ud658\uad70\uc758 \uc704\uc218 \uc124\uba85\uacfc \uc99d\uba85\uc5d0 \ud544\uc694\ud55c \uc218\uc2dd\u00b7\ub4f1\uc2dd\uc774 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube44\uc5b4 \uc788\ub2e4. \ube60\uc9c4 \ud45c\ud604 \uc5c6\uc774 \ub17c\uc99d\uc744 \ubcf5\uad6c\ud560 \uc218 \uc5c6\uc5b4 HOLD\ud55c\ub2e4.": 1, "Tashi Thinles \ud45c\uae30 \ub4a4 \uc11c\ub85c \ub2e4\ub978 \ubc94\uc704\uc77c \uc218 \uc788\ub294 \uace0\ub3c4\u00b7\uc751\uae09\ucc98\uce58\u00b7\uc800\uccb4\uc628 \uc548\ub0b4\uac00 \uc774\uc5b4\uc9c0\uace0, \uc810\uc218\ud45c\uc640 \uc0dd\uc874\uc2dc\uac04 \ud45c\uc758 \ud589 \uc5f0\uacb0\uc774 \ube60\uc838 \uc788\ub2e4. \uc0c1\uc2b9 \uad8c\uace0 \ub450 \ubb38\uc7a5\uc740 \uc870\uac74\uc774 \ub2e4\ub97c \uc218\ub3c4 \uc788\uc5b4 \ud558\ub098\ub97c \uace0\ub974\uc9c0 \uc54a\uc558\ub2e4. \uc758\ud559\uc801 \uc0ac\uc2e4 \uac80\uc99d\uc774\ub098 \uc218\uce58 \ubcf5\uad6c\ub294 \ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uae08\uc735 \ubb38\ud56d \ubaa9\ub85d\uc73c\ub85c \uc2dd\ubcc4\ub418\ubbc0\ub85c \ubc18\ubcf5 \uac00\ub2a5\uc131\ub9cc\uc73c\ub85c \uc804\uccb4\ub97c \ubcf4\ub958\ud560 \uc774\uc720\ub294 \uc5c6\ub2e4. \ub2e4\ub9cc \ubb38\ud56d `10`\uc740 `11.50%,`\uc5d0\uc11c \ub05d\ub098\uace0, `13`\uc740 \uc81c\uc2dc\ub418\uc9c0 \uc54a\uc740 I\u2013IV\ub97c \uac00\ub9ac\ud0a4\uba70, `17`\uc740 `equal to` \ub4a4 \ubaa9\uc801\uc5b4\uac00 \uc5c6\ub2e4. \uc120\ud0dd\uc9c0\uac00 \uc77c\ubd80\ub9cc \ubcf4\uc774\ub294 \ubb38\ud56d\ub3c4 \uc788\ub2e4. \ubb38\ud56d \ubc88\ud638\u00b7\uae08\uc561\u00b7\uc774\uc728\u00b7\uc788\ub294 \uc120\ud0dd\uc9c0\ub97c \ubcf4\uc874\ud558\ub418 \ub204\ub77d \ubb38\ud56d\uc774\ub098 \uc815\ub2f5\uc744 \ub9cc\ub4e4 \uc218 \uc5c6\ub2e4.": 1, "\uc911\uc559\uac12 \ubb38\uc81c\uc758 \uc785\ub825 \uc218 \uc815\uc758\uc640 \uc815\uc218 \uc810\uc218 \uc790\ub9ac\uac00 \ube44\uace0 \ub450 \uc0d8\ud50c \ucd9c\ub825\ub3c4 \uc5c6\uc74c. \ub313\uae00\uc740 \ubc18\uc62c\ub9bc \uc870\uc5b8\uc774 \uc11c\ub85c \ub2e4\ub974\uace0 \ub3c5\ub9bd \ubb38\ub9e5\uc774 \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc544 \ubd80\ubd84 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc74c. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "Java \uacfc\uc81c \ub3c4\uc6c0 \uc694\uccad\uacfc \ubd88\uc644\uc804\ud55c \ucf54\ub4dc \uc870\uac01\ub9cc \uc788\ub2e4. \uc124\uba85\u00b7\ud574\uacb0 \uacfc\uc815\uc774 \uc5c6\uc5b4 \ub3c5\ub9bd \ub2f5\ubcc0 \ubcf8\ubb38\uc73c\ub85c \ubcf5\uad6c\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1}, "all_reasons": {"SOURCE_BOUNDARY_NOT_RECOVERABLE": 3, "APPENDIX_CATEGORY_BOUNDARY_REQUIRES_CONTEXT": 194234, "UNRESOLVED_FIELD_OR_TITLE": 158187, "MAIN_BODY_REPETITION_REQUIRES_CONTEXT": 70116, "BROKEN_TABLE_OR_WIKI_MARKUP": 11046, "AMBIGUOUS_STRUCTURE_LABEL_REQUIRES_CONTEXT": 30550, "MARKUP_OR_TRANSCRIPTION_REQUIRES_CONTEXT": 9894, "NONBODY_UI_REQUIRES_CONTEXT_EDIT": 4518, "UNRESOLVED_RAW_TABLE_OR_CLOSING_WIKI_MARKUP": 1407, "INTERNAL_BIRTH_YEAR_CONFLICT_UNRESOLVED": 5292, "POPULATED_NAVIGATION_REQUIRES_CONTEXT_EDIT": 3405, "INDEPENDENT_PROSE_NOT_ESTABLISHED": 3571, "INHERITED_INDIVIDUAL_HOLD_REQUIRES_SOURCE_SHA_REVIEW": 3621, "MISSING_EXPRESSION_OR_STRAY_FRAGMENT": 2090, "\uc5f0\ud638\u00b7\uae30\ub144\u00b7\uc0ac\uac74\u00b7\ud0c4\uc0dd\u00b7\uc0ac\ub9dd \ubaa9\ub85d\uc740 \uc788\uc73c\ub098 \uc774 \uc790\ub8cc\ub97c \uace0\uc815\ud560 \uc5f0\ub3c4 \uc81c\ubaa9\uc774\ub098 \uc5f0\ub3c4\uac00 \uc5c6\ub2e4. \uc5f0\ud638 \uac12\ub9cc\uc73c\ub85c \uc808\ub300 \uc5f0\ub3c4\ub97c \ucd94\uc815\ud558\uc9c0 \uc54a\uc558\ub2e4.": 2, "OPEN_ACTUAL_CODE_FENCE": 11, "\uc6d0\ubb38\u00b7\uc81c\uc548\ubb38\uc740 \ub3d9\uc77c\ud558\ub2e4. \ub17c\ubb38\uc740 \ub3c5\ub9bd\uc801\uc778 \ud559\uc220 \uae00\uc774\uace0 \ucc38\uace0\ubb38\ud5cc\u00b7\uc778\uc6a9\u00b7\uc800\uc790 \uac10\uc0ac \ubb38\uad6c\ub3c4 \ubcf4\uc874\ud574\uc57c \ud558\uc9c0\ub9cc, \ub3c4\uc785\ubd80\uc758 `(or )`, \ubc18\ubcf5\ub418\ub294 \ube48 \uae30\ud638\u00b7\ubcc0\uc218, `and` \uc55e\ub4a4\uc5d0 \ube44\uc5b4 \uc788\ub294 \uc218\uc2dd\uc774 Markov chain\u00b7\uadf8\ub798\ud504 \ubd84\ud560 \uc815\uc758\uc640 \uacb0\uacfc\uc5d0 \uac78\uccd0 \ub098\ud0c0\ub09c\ub2e4. \uc774 \ud575\uc2ec \uc218\uc2dd\u00b7\ub9e4\uac1c\ubcc0\uc218 \uc5c6\uc774\ub294 \uc124\uba85\uc758 \uc758\ubbf8\ub97c \ud655\uc815\ud560 \uc218 \uc5c6\uc5b4 \ubcf4\ub958\ud55c\ub2e4.": 2, "388\uc758 \uc815\uc758\uc640 \uc57d\uc218 \ubaa9\ub85d, \uc5f0\ub3c4 \ud45c\uae30\ub294 \ub3c5\ub9bd \ub0b4\uc6a9\uc73c\ub85c \uc77d\ud78c\ub2e4. \ud558\uc9c0\ub9cc \ub05d\uc758 `3e02 388`\uc774 \ubcf8\ubb38 \uc218\uc2dd\u00b7\ubcc4\uce6d\u00b7\uc794\uc5ec \uc870\uac01 \uc911 \ubb34\uc5c7\uc778\uc9c0 \uc54c \uc218 \uc5c6\uace0 `\uacfc\ud559` \ud45c\uc81c\ub3c4 \ube44\uc5b4 \uc788\ub2e4. \uc774\ub97c 388\uc758 \uacfc\ud559\uc801 \ud45c\uae30\ub77c\uace0 \ub2e8\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "\uacc4\ucc28\uc218\uc5f4 \uc815\uc758\u00b7\uc608\u00b7\uc131\uc9c8 \uc804\ubc18\uc5d0\uc11c \uc218\uc5f4 \uae30\ud638\uc640 \uc218\uc2dd \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4. \uc608\ub97c \ub4e4\uc5b4 `\uc218\uc5f4` \ub2e4\uc74c \uc785\ub825, \uc77c\ubc18\ud56d, \ub2e8\uc870\uc131\uc758 \ud544\uc694\ucda9\ubd84\uc870\uac74, \uace0\uacc4 \ub4f1\ucc28\uc218\uc5f4\uc758 \ucc28\uc218 \ud45c\uae30\uac00 \ub204\ub77d\ub418\uc5b4 \uc218\ud559\uc801 \uad00\uacc4\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4. \ucc38\uace0 \ud56d\ubaa9\uacfc \ubaa9\ub85d\uc740 \ubcf4\uc874\ud558\ub418 \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "Basic VML Types\ub77c\ub294 \uc8fc\uc81c\uc640 \uc5ec\ub7ec \uc124\uba85\uc740 \uc77d\ud788\uc9c0\ub9cc \uc720\ud615\ud45c\uc640 \uc0c9\uc0c1 \ud1a0\ud070 \ud45c\uc758 \ud544\ub4dc \uc5f0\uacb0\uc774 \ube44\uace0 \uc218\uc2dd\u00b7\ud0dc\uadf8 \uacbd\uacc4\uac00 \uc190\uc0c1\ub418\uc5b4 \ud575\uc2ec \uc815\uc758\ub97c \uc548\uc804\ud558\uac8c \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4. \uc548\uc804\ud55c \uc644\uacb0 \ubcf8\ubb38 \uacbd\uacc4\ub97c \uc7a1\uae30 \uc5b4\ub824\uc6cc \uc804\uccb4 \ubcf4\ub958\ud558\uace0 \uc608\uc2dc\ub97c hold \ud30c\uc77c\uc5d0 \uc801\uc5c8\ub2e4.": 2, "\ubc18\uc751\ud615 \uae00\uc790 \ud06c\uae30\uc5d0 \ub300\ud55c \uc124\uba85\uc740 \ub3c5\ub9bd\ub41c \uae30\uc220 \uae00\uc774\uc9c0\ub9cc, \u201c\ucf54\ub4dc\ub294 \ub2e4\uc74c\uacfc \uac19\ub2e4\u201d, \u201c\uc774 \ud568\uc218\u201d, \u201c\ub610 \ub2e4\ub978 \uc608\u201d, \u201c\uc815\ub9ac\ud558\uba74\u201d \ub4a4\uc5d0 \uc124\uba85\uc774 \uac00\ub9ac\ud0a4\ub294 \ucf54\ub4dc \uc608\uc81c\uac00 \uc5c6\ub2e4. \ub204\ub77d\ub41c Sass/CSS \uc608\uc81c\ub97c \uc0dd\uc131\ud560 \uc218 \uc5c6\uace0, \uadf8 \ubb38\uc7a5\ub4e4\uc744 \uc0ad\uc81c\ud558\uba74 \uc124\uba85 \uad00\uacc4\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\ub2e4. \uad00\ub828 \uc218\uce58\u00b7\ub2e8\uc704\u00b7HTML \uc694\uc18c\u00b7\uc6a9\uc5b4\ub294 \ubcf4\uc874\ud558\uace0 \ub204\ub77d \uad6c\uac04\ub9cc \ubcf4\ub958\ud55c\ub2e4.": 2, "\uc81c\ubaa9\uacfc 2010~2012 \uc5f0\ub3c4 \ud45c\uc81c, \uad00\ub828 \ub9c1\ud06c\ub9cc \uc788\uace0 \uc870\uc120\ubbfc\uc8fc\uc8fc\uc758\uc778\ubbfc\uacf5\ud654\uad6d \ucd95\uad6c \uad6d\uac00\ub300\ud45c\ud300 \uacbd\uae30 \uacb0\uacfc\uac00 \uc5c6\ub2e4. \ub9c1\ud06c\ub9cc\uc73c\ub85c \uacb0\uacfc\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4.": 2, "\uc218\ud559 \uc18c\uac1c\u00b7\uc2dc\ud5d8\u00b7ACCA \ud64d\ubcf4\uc131 \ubb38\uad6c\uac00 \ud55c \ubb38\uc7a5 \ud750\ub984 \uc548\uc5d0 \uc11e\uc774\uace0 \uc22b\uc790\uc640 \ub17c\uc9c0\uc758 \uacbd\uacc4\uac00 \ub04a\uaca8 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud560 \uc218 \uc5c6\uc74c.": 2, "K\ud31d\uc2a4\ud0c0 \ubc29\uc1a1 \uacb0\uacfc \ud45c\uc758 \uc704\ud0a4 \ud14c\uc774\ube14 \uad6c\uc870\uac00 \uae68\uc838 \uc788\ub2e4. \ud2b9\ud788 \ud328\uc790\ubd80\ud65c\uc804 \ubd80\ubd84\uc758 `\uc0dd\ubc29\uc1a1 \uc9c4\ucd9c|-` \ub4f1 \ud589 \uacbd\uacc4\uac00 \ubd99\uc5b4 \uc788\uace0, \uc5f4\ubcc4 \uacb0\uacfc\u00b7\ud2b9\uc774\uc0ac\ud56d \uc140 \uad00\uacc4\uac00 \ubd88\uba85\ud655\ud558\ub2e4. \ud45c\uc758 \ud589\u00b7\uc774\ub984\u00b7\uace1\u00b7\uc18c\uc18d\uc0ac\u00b7\uc21c\uc704\ub97c \uc7ac\ubc30\uce58\ud558\uac70\ub098 \uace0\uce58\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\ubcc0 \uc124\uba85\uacfc \uc218\uce58\ub294 \ubcf4\uc874\ud55c\ub2e4.": 2, "\ub85c\uadf8\ub7ad\ud06c \uac80\uc815 \uc124\uba85\uc740 \uc8fc\uc81c\uac00 \uba85\ud655\ud558\uc9c0\ub9cc, \uc704\ud5d8\uc9d1\ub2e8\u00b7\uc0ac\uac74 \uc218\uc758 \uae30\ud638, \uae30\ub313\uac12\u00b7\ubd84\uc0b0, \uac80\uc815\ud1b5\uacc4\ub7c9, \uc815\uaddc\uadfc\uc0ac\uc640 \ud45c\ubcf8\uc218 \uacc4\uc0b0\uc758 \ud575\uc2ec \uc218\uc2dd \uc790\ub9ac\uac00 \ub2e4\uc218 \ube44\uc5b4 \uc788\ub2e4. \uc11c\uc9c0\uc640 \uac1c\ub150 \uc124\uba85\uc740 \ub530\ub85c \ubcf4\uc874\ud560 \uc218 \uc788\uc73c\ub098 \uc218\uc2dd\uc758 \uad00\uacc4\ub97c \ubcf5\uad6c\ud55c \uc644\uacb0 \ud1b5\uacc4 \uc124\uba85\uc73c\ub85c \ucde8\uae09\ud560 \uc218 \uc5c6\ub2e4. \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 2, "\uc6d0\ubb38 \uc804\uccb4\uac00 ParaPro \ud50c\ub798\uc2dc\uce74\ub4dc \uc11c\ube44\uc2a4 \ud64d\ubcf4\u00b7\uac00\uc785/\ub2e4\uc6b4\ub85c\ub4dc \uc548\ub0b4\u00b7\ud6c4\uae30 \uc694\uccad\uc774\ub2e4. \uc2e4\uc81c \ud559\uc2b5 \uce74\ub4dc\u00b7\uc138\ud2b8\u00b7\ubb38\ud56d\u00b7\ub2f5\ubcc0\uc774 \uc5c6\uc5b4 \uad50\uc721 \ubcf8\ubb38\uc73c\ub85c \uc62c\ub9b4 \ub3c5\ub9bd\uc801\uc778 \ud559\uc2b5 \ub0b4\uc6a9\uc774 \uc5c6\ub2e4. \uc6d0\ubb38 \uc804\uccb4\ub97c \ubcf4\ub958 \uae30\ub85d\uc5d0 \uadf8\ub300\ub85c \ubcf4\uc874\ud588\ub2e4.": 2, "\ube48 `External links` \ud45c\uc81c\ub97c \uc81c\uac70\ud55c \ubcc0\uacbd \uc790\uccb4\ub294 \uc548\uc804\ud558\ub2e4. \ub2e4\ub9cc \ubcf8\ubb38 `electron densities \u2013 cm and pressures \u2013 K cm`\uc5d0\uc11c \ubc00\ub3c4\u00b7\uc555\ub825 \ud45c\ud604\uc774 \ube44\uc5b4 \uc788\uc5b4 \ubb3c\ub9ac \uc124\uba85\uc774 \uc190\uc0c1\ub3fc \uc788\ub2e4. \uc5c6\ub294 \uc2dd\u00b7\uac12\uc740 \ucd94\uc815\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc774 \uc190\uc0c1 \uad6c\uac04\uc744 \ubcf4\ub958\ud55c\ub2e4. \uc815\uc0c1 \uc11c\uc9c0 \ud56d\ubaa9\uc740 \uc804\ubd80 \ubcf4\uc874\ud55c\ub2e4.": 2, "\uc774 \uc790\ub8cc\ub294 \uc11c\ub85c \ub2e4\ub978 \ubc88\ud638 \uccb4\uacc4\ub85c \ub2e4\uc2dc \uc2dc\uc791\ud558\ub294 \uc6b4\uc728\u00b7\ud589\ubcc4 \ud559\uc220 \uc8fc\uc11d\ub9cc \ub2f4\uace0 \uc788\ub2e4. `this masque`, `this line`, `the manuscript` \ub4f1\uc740 \uc774\ub984\uacfc \uc6d0\ubb38 \uad6c\uc808\uc774 \uc5c6\ub294 \ub2e4\ub978 \ubb38\uc11c\uc5d0 \uc758\uc874\ud558\uba70, \ub450 \ubc88\uc9f8 `1 - 6` \ubb36\uc74c\ub3c4 \uc5b4\ub290 \uc791\ud488\uc778\uc9c0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc81c\ubaa9 \ubd80\uc7ac\ub9cc\uc774 \uc544\ub2c8\ub77c \uc8fc\uc11d\uc774 \ubd99\uc744 \uc6d0\ubb38\u00b7\uc791\ud488 \uacbd\uacc4\uac00 \uc190\uc2e4\ub418\uc5b4 \ub3c5\ub9bd\uc801\uc73c\ub85c \uadc0\uc18d\ud560 \uc218 \uc5c6\ub2e4. \uc8fc\uc11d\u00b7\uc6b4\uc728\u00b7\uc778\uc6a9 \uc790\uccb4\ub97c \ubc84\ub9ac\uc9c0 \ub9d0\uace0 \uc6d0\ubb38 \ub9e5\ub77d\uc744 \ud655\uc778\ud560 \ub54c\uae4c\uc9c0 \ubcf4\ub958\ud55c\ub2e4.": 2, "\uc778\ud130\ub137\u00b7\uac8c\uc784\u00b7\ud559\uc5c5 \uc131\uacfc\uc5d0 \uad00\ud55c \uc11c\ub85c \ub2e4\ub978 \ubb38\ub2e8, \ub04a\uae34 \uc778\uc6a9, \ucd9c\ucc98\u00b7\uc800\uc790 \uc815\ubcf4\uc640 \uc2ac\ub77c\uc774\ub4dc UI\uac00 \uc11e\uc600\ub2e4. \uc8fc\uc7a5\uacfc \uc778\uc6a9 \uc8fc\uccb4\uc758 \uacbd\uacc4\uac00 \uc18c\uc2e4\ub418\uc5b4 \ub3c5\ub9bd \ubb38\uc7a5\uc744 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud558\uae30 \uc5b4\ub835\ub2e4.": 2, "\ube14\ub85c\uadf8 \uc544\uce74\uc774\ube0c\uc5d0\uc11c \uc5ec\ub7ec \uae00 \uc870\uac01\uacfc Tag Archives\u00b7\ub313\uae00\u00b7\ud0dc\uadf8\uac00 \uad50\ucc28\ud55c\ub2e4. \uc81c\ubaa9\u00b7\uac8c\uc2dc\ubb3c \uacbd\uacc4\uac00 \ubd80\uc871\ud574 \uac1c\ubcc4 \uae00\ub85c \uc790\ub974\uba74 \uc778\uc6a9\u00b7\uacac\ud574 \uadc0\uc18d\uc744 \ucd94\uc815\ud558\uac8c \ub418\uc5b4 \uc0c8 \ubcf8\ubb38\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 2, "OBSERVED_PAGE_WIDGET_REQUIRES_CONTEXT_EDIT": 44, "\ud574\ube59\u00b7\uadf8\ub9b0\ub780\ub4dc \uc721\ube59\u00b7\ub2ec \ud06c\uae30 \ubc14\uc704 \uad00\ub828 \uc124\uba85\uc740 \uc77c\ubd80 \ub0a8\uc9c0\ub9cc \uc9c8\ubb38 \ub300\uc0c1\uacfc \uc55e\ub4a4 \ubb38\ub9e5\uc774 \uc5c6\ub2e4. PerlMonks \uac8c\uc2dc \uc548\ub0b4\u00b7HTML \uc9c0\uce68\uacfc \ud0d0\uc0c9 UI\ub3c4 \ubcf8\ubb38\uc5d0 \uc11e\uc5ec \uc788\ub2e4. \ub2f5\ubcc0 \ubc94\uc704\uc640 UI \uc81c\uac70\uc120\uc744 \ud14d\uc2a4\ud2b8\ub9cc\uc73c\ub85c \ud655\uc815\ud558\uae30 \uc5b4\ub835\ub2e4.": 1, "\uae30\uc0ac \uacbd\uacc4\uc640 \ubb38\uc7a5 \uc5f0\uacb0\uc774 \uc190\uc0c1\ub41c \uc0c1\ud0dc\uc5d0 \uc0dd\ubb3c\ubb34\uae30 \uc900\ube44\u00b7\ud655\uc0b0\uc758 \uc815\ub7c9 \uae30\uc220 \ub0b4\uc6a9\uc774 \uc11e\uc5ec \uc788\ub2e4. \ub3c5\ub9bd \ubcf8\ubb38\uc744 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc558\uace0 \uc0c8 \ubcf8\ubb38\uc774\ub098 \ubcf5\uc0ac \ubd80\ub85d\ub3c4 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 1, "\ud558\uc774\ud401 \uc5ed\uc774 1910\ub144\uc5d0 \ud611\uada4\uc5ed\uc73c\ub85c \uac1c\uc5c5\ud588\ub2e4\ub294 \uc18c\uac1c\uc640, 1902\ub144 6\uc6d4 16\uc77c \ucca0\ub3c4 \uc644\uacf5 \ubc0f \uc5ed \uac1c\uc5c5\uc774\ub77c\ub294 \uc5f0\ud601\uc774 \ud568\uaed8 \uc788\uc5b4 \ub0a0\uc9dc\uac00 \ucda9\ub3cc\ud55c\ub2e4. source SHA \ubc0f \uc678\ubd80 \uc790\ub8cc\ub97c \ud655\uc778\ud560 \uc218 \uc5c6\uace0 \uc804\ud6c4 \uc5ed \uc808\ub3c4 \ube44\uc5b4 \uc788\uc5b4 \ucda9\ub3cc\uc744 \uc784\uc758\ub85c \uc815\uaddc\ud654\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uc5ec\ub7ec \uc9e7\uc740 \ub300\uc0ac\u00b7\uc81c\ubaa9\uacfc \uac01 `Tags:` \ud56d\ubaa9\uc774 \uc774\uc5b4\uc9c0\uc9c0\ub9cc, \uadf8\uac83\ub4e4\uc774 \uc5b4\ub5a4 \uc791\ud488\u00b7\uc0c1\ud669\uc5d0 \uc18d\ud558\ub294\uc9c0 \ubcf8\ubb38\uc5d0\uc11c \uc2dd\ubcc4\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38\uacfc \uc81c\uc548\ubb38\uc740 \uac19\uace0 \uc0ad\uc81c \uc190\uc2e4\uc740 \uc5c6\uc73c\ub098, \uc804\uccb4\ub97c \ub3c5\ub9bd\uc801\uc778 \uc0b0\ubb38\uc73c\ub85c \ud655\uc815\ud560 \uadfc\uac70\ub3c4 \uc5c6\ub2e4. \ub300\uc0ac\u00b7\ud0dc\uadf8\ub97c \uc784\uc758\ub85c \uc9dd\uc9d3\uac70\ub098 \ubb38\ub9e5\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uad00\uacc4 \ub300\uc218\uc758 \ud575\uc2ec \uae30\ud638\u00b7\uc815\uc758\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \uc18c\uc2e4\ub418\uace0 SQL \uc608\ub9cc\uc73c\ub85c \uc6d0\ub798 \uad00\uacc4\ub97c \ubcf5\uad6c\ud560 \uadfc\uac70\uac00 \ubd80\uc871\ud568. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "\ubcf8\ubb38\uc740 \ubd80\ub098 \uc0ac\ub974\uc758 \uc0dd\ub144\uc6d4\uc77c\uc744 1992\ub144 1\uc6d4 31\uc77c\ub85c \uc801\uc9c0\ub9cc \ubd84\ub958\uc5d0\ub294 1991\ub144 \ucd9c\uc0dd\uc774 \uc788\uc5b4 \ub0b4\ubd80 \uc5f0\ub3c4\uac00 \ucda9\ub3cc\ud55c\ub2e4. \uc678\ubd80 \ud655\uc778\uc774\ub098 \uc784\uc758 \uc815\uc815\uc744 \ud558\uc9c0 \uc54a\uc558\uc73c\ubbc0\ub85c \uc6d0\ubb38 \uadf8\ub300\ub85c KEEP\ud558\ub294 \uc81c\uc548\uc744 \ubb34\uc870\uac74 \ud1b5\uacfc\uc2dc\ud0ac \uc218 \uc5c6\ub2e4.": 1, "\ud558\uae30\uc640\ub77c\uc815 \uc18c\uac1c\u00b7\uc9c0\ub9ac\u00b7\uc5ed\uc0ac\u00b7\ucca0\ub3c4\u00b7\ub3c4\ub85c \uc815\ubcf4\ub294 \ub300\ubd80\ubd84 \uc77d\ud788\uc9c0\ub9cc, \uc5ed\uc0ac \uc55e\uc758 \uc5f4\ub9b0 \ucf54\ub4dc \ud39c\uc2a4 \ud45c\uc2dd\uc774 \ub0a8\uc544 \uc788\uace0 \ud569\ubcd1\uc77c\uc774 \uc18c\uac1c\uc5d0\ub294 2004-04-01, \uc5ed\uc0ac\uc5d0\ub294 2004-03-01\ub85c \uc11c\ub85c \ub2e4\ub974\ub2e4. \ub450 \ub0a0\uc9dc\ub97c \ub2e8\uc77c \uac12\uc73c\ub85c \ubc14\uafb8\uac70\ub098 \uc5f4\ub9b0 \ud45c\uc2dd\uc744 \uc784\uc758 \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4.": 1, "\ube44\uad50\u00b7\ub300\uc870 \uae00\uc4f0\uae30 \uc548\ub0b4\ub294 \uc628\uc804\ud55c \ub3c5\ub9bd \ub2f5\ubcc0\uc774\ub2e4. \ub2e4\ub9cc \u201c~~~2A. detail 1\u201d \ub4f1 \uc904\uc740 \uac1c\uc694 \ud45c\uae30\ucc98\ub7fc \uc77d\ud788\ub294 \ub3d9\uc2dc\uc5d0 \ub2eb\ub294 \uc904\uc774 \uc5c6\ub294 \uc2e4\uc81c Markdown \ud39c\uc2a4 \uad6c\ubb38\uc774\ub2e4. \uc758\ub3c4\ub41c \ud45c\uae30\uc778\uc9c0 \uc190\uc0c1\ub41c \ud39c\uc2a4\uc778\uc9c0 \uc6d0\ubb38\ub9cc\uc73c\ub85c \uc815\ud560 \uc218 \uc5c6\uc5b4 \uc0ad\uc81c\u00b7\uc7ac\ubc30\uce58\u00b7\uc885\uacb0\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub05d\uc758 \ubbf8\uad6d\uc0ac \uc9c8\ubb38 \ubaa9\ub85d\ub3c4 \uacbd\uacc4 \ud45c\uc81c\uac00 \uc5c6\uc5b4 \uad00\ub828\ubb38\ud56d\uc778\uc9c0 \ubcc4\ub3c4 UI\uc778\uc9c0 \ubd88\ud655\uc815\uc774\ub2e4. \uc55e\uc758 \uc548\ub0b4\ubb38\uc740 \ub3c5\ub9bd \ubcf4\uc874 \uac00\ub2a5\ud558\ub2e4.": 1, "\uacbd\ub9e4/\ud310\ub9e4 \ud56d\ubaa9\uc5d0 \uc2e0\ubb38 \ubc1c\ucdcc, \uc0dd\ub7b5\ubd80\ud638, \ud310\ub9e4 \uc124\uba85, \uc885\uc774 \uc0c1\ud0dc\uac00 \uc11e\uc5ec \uc6d0\uc2e0\ubb38 \ub3c5\ub9bd \ubcf8\ubb38\uacfc \uc778\uc6a9 \uacbd\uacc4\ub97c \uad6c\ubd84\ud560 \uc218 \uc5c6\ub2e4. \ub0a0\uc9dc\u00b7\ud56d\ubaa9\ubc88\ud638\u00b7\uc778\uc6a9\uc740 \ubcf5\uc6d0\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "DFT\u00b7FFT, Blackman/Hann \ucc3d, \uc0c1\uad00\u00b7PSD\u00b7coherence \uad00\ub828 \ubcf8\ubb38\uacfc Matlab/Octave \ucf54\ub4dc \ubc0f \uc11c\uc9c0\ub294 \uc0c1\ub2f9 \ubd80\ubd84 \ubcf4\uc874\ub3fc \uc788\uc73c\ub098 \uc815\uc758\uc2dd\u00b7\ubcc0\uc218\u00b7\uc218\uce58\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube60\uc838 \ub4a4 \ubb38\uc7a5\uc774 \ube48 \uae30\ud638\ub97c \ucc38\uc870\ud55c\ub2e4. \ud398\uc774\uc9c0\u00b7\uadf8\ub9bc\uc744 \ubcf4\uc9c0 \uc54a\uace0 \uc218\uc2dd\uc774\ub098 \uc870\uac74\uc744 \ubcf5\uc6d0\ud560 \uc218 \uc5c6\uc5b4 \uc7a5 \uc804\uccb4\ub97c \uc815\uc0c1 \uae30\uc220 \uc124\uba85\uc73c\ub85c \ucc44\ud0dd\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc77d\uae30\ub9cc \ud588\uace0 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uc21c\ud658\uad70\uc758 \uc704\uc218 \uc124\uba85\uacfc \uc99d\uba85\uc5d0 \ud544\uc694\ud55c \uc218\uc2dd\u00b7\ub4f1\uc2dd\uc774 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube44\uc5b4 \uc788\ub2e4. \ube60\uc9c4 \ud45c\ud604 \uc5c6\uc774 \ub17c\uc99d\uc744 \ubcf5\uad6c\ud560 \uc218 \uc5c6\uc5b4 HOLD\ud55c\ub2e4.": 1, "Tashi Thinles \ud45c\uae30 \ub4a4 \uc11c\ub85c \ub2e4\ub978 \ubc94\uc704\uc77c \uc218 \uc788\ub294 \uace0\ub3c4\u00b7\uc751\uae09\ucc98\uce58\u00b7\uc800\uccb4\uc628 \uc548\ub0b4\uac00 \uc774\uc5b4\uc9c0\uace0, \uc810\uc218\ud45c\uc640 \uc0dd\uc874\uc2dc\uac04 \ud45c\uc758 \ud589 \uc5f0\uacb0\uc774 \ube60\uc838 \uc788\ub2e4. \uc0c1\uc2b9 \uad8c\uace0 \ub450 \ubb38\uc7a5\uc740 \uc870\uac74\uc774 \ub2e4\ub97c \uc218\ub3c4 \uc788\uc5b4 \ud558\ub098\ub97c \uace0\ub974\uc9c0 \uc54a\uc558\ub2e4. \uc758\ud559\uc801 \uc0ac\uc2e4 \uac80\uc99d\uc774\ub098 \uc218\uce58 \ubcf5\uad6c\ub294 \ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uae08\uc735 \ubb38\ud56d \ubaa9\ub85d\uc73c\ub85c \uc2dd\ubcc4\ub418\ubbc0\ub85c \ubc18\ubcf5 \uac00\ub2a5\uc131\ub9cc\uc73c\ub85c \uc804\uccb4\ub97c \ubcf4\ub958\ud560 \uc774\uc720\ub294 \uc5c6\ub2e4. \ub2e4\ub9cc \ubb38\ud56d `10`\uc740 `11.50%,`\uc5d0\uc11c \ub05d\ub098\uace0, `13`\uc740 \uc81c\uc2dc\ub418\uc9c0 \uc54a\uc740 I\u2013IV\ub97c \uac00\ub9ac\ud0a4\uba70, `17`\uc740 `equal to` \ub4a4 \ubaa9\uc801\uc5b4\uac00 \uc5c6\ub2e4. \uc120\ud0dd\uc9c0\uac00 \uc77c\ubd80\ub9cc \ubcf4\uc774\ub294 \ubb38\ud56d\ub3c4 \uc788\ub2e4. \ubb38\ud56d \ubc88\ud638\u00b7\uae08\uc561\u00b7\uc774\uc728\u00b7\uc788\ub294 \uc120\ud0dd\uc9c0\ub97c \ubcf4\uc874\ud558\ub418 \ub204\ub77d \ubb38\ud56d\uc774\ub098 \uc815\ub2f5\uc744 \ub9cc\ub4e4 \uc218 \uc5c6\ub2e4.": 1, "\uc911\uc559\uac12 \ubb38\uc81c\uc758 \uc785\ub825 \uc218 \uc815\uc758\uc640 \uc815\uc218 \uc810\uc218 \uc790\ub9ac\uac00 \ube44\uace0 \ub450 \uc0d8\ud50c \ucd9c\ub825\ub3c4 \uc5c6\uc74c. \ub313\uae00\uc740 \ubc18\uc62c\ub9bc \uc870\uc5b8\uc774 \uc11c\ub85c \ub2e4\ub974\uace0 \ub3c5\ub9bd \ubb38\ub9e5\uc774 \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc544 \ubd80\ubd84 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc74c. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "Java \uacfc\uc81c \ub3c4\uc6c0 \uc694\uccad\uacfc \ubd88\uc644\uc804\ud55c \ucf54\ub4dc \uc870\uac01\ub9cc \uc788\ub2e4. \uc124\uba85\u00b7\ud574\uacb0 \uacfc\uc815\uc774 \uc5c6\uc5b4 \ub3c5\ub9bd \ub2f5\ubcc0 \ubcf8\ubb38\uc73c\ub85c \ubcf5\uad6c\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1}, "unique_first_reasons": {"SOURCE_BOUNDARY_NOT_RECOVERABLE": 3, "APPENDIX_CATEGORY_BOUNDARY_REQUIRES_CONTEXT": 130630, "UNRESOLVED_FIELD_OR_TITLE": 83686, "MAIN_BODY_REPETITION_REQUIRES_CONTEXT": 41599, "BROKEN_TABLE_OR_WIKI_MARKUP": 6875, "AMBIGUOUS_STRUCTURE_LABEL_REQUIRES_CONTEXT": 18857, "MARKUP_OR_TRANSCRIPTION_REQUIRES_CONTEXT": 5014, "NONBODY_UI_REQUIRES_CONTEXT_EDIT": 2910, "UNRESOLVED_RAW_TABLE_OR_CLOSING_WIKI_MARKUP": 799, "POPULATED_NAVIGATION_REQUIRES_CONTEXT_EDIT": 2178, "INDEPENDENT_PROSE_NOT_ESTABLISHED": 1689, "INTERNAL_BIRTH_YEAR_CONFLICT_UNRESOLVED": 448, "INHERITED_INDIVIDUAL_HOLD_REQUIRES_SOURCE_SHA_REVIEW": 1770, "MISSING_EXPRESSION_OR_STRAY_FRAGMENT": 1001, "\uc5f0\ud638\u00b7\uae30\ub144\u00b7\uc0ac\uac74\u00b7\ud0c4\uc0dd\u00b7\uc0ac\ub9dd \ubaa9\ub85d\uc740 \uc788\uc73c\ub098 \uc774 \uc790\ub8cc\ub97c \uace0\uc815\ud560 \uc5f0\ub3c4 \uc81c\ubaa9\uc774\ub098 \uc5f0\ub3c4\uac00 \uc5c6\ub2e4. \uc5f0\ud638 \uac12\ub9cc\uc73c\ub85c \uc808\ub300 \uc5f0\ub3c4\ub97c \ucd94\uc815\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "OPEN_ACTUAL_CODE_FENCE": 7, "\uc6d0\ubb38\u00b7\uc81c\uc548\ubb38\uc740 \ub3d9\uc77c\ud558\ub2e4. \ub17c\ubb38\uc740 \ub3c5\ub9bd\uc801\uc778 \ud559\uc220 \uae00\uc774\uace0 \ucc38\uace0\ubb38\ud5cc\u00b7\uc778\uc6a9\u00b7\uc800\uc790 \uac10\uc0ac \ubb38\uad6c\ub3c4 \ubcf4\uc874\ud574\uc57c \ud558\uc9c0\ub9cc, \ub3c4\uc785\ubd80\uc758 `(or )`, \ubc18\ubcf5\ub418\ub294 \ube48 \uae30\ud638\u00b7\ubcc0\uc218, `and` \uc55e\ub4a4\uc5d0 \ube44\uc5b4 \uc788\ub294 \uc218\uc2dd\uc774 Markov chain\u00b7\uadf8\ub798\ud504 \ubd84\ud560 \uc815\uc758\uc640 \uacb0\uacfc\uc5d0 \uac78\uccd0 \ub098\ud0c0\ub09c\ub2e4. \uc774 \ud575\uc2ec \uc218\uc2dd\u00b7\ub9e4\uac1c\ubcc0\uc218 \uc5c6\uc774\ub294 \uc124\uba85\uc758 \uc758\ubbf8\ub97c \ud655\uc815\ud560 \uc218 \uc5c6\uc5b4 \ubcf4\ub958\ud55c\ub2e4.": 1, "388\uc758 \uc815\uc758\uc640 \uc57d\uc218 \ubaa9\ub85d, \uc5f0\ub3c4 \ud45c\uae30\ub294 \ub3c5\ub9bd \ub0b4\uc6a9\uc73c\ub85c \uc77d\ud78c\ub2e4. \ud558\uc9c0\ub9cc \ub05d\uc758 `3e02 388`\uc774 \ubcf8\ubb38 \uc218\uc2dd\u00b7\ubcc4\uce6d\u00b7\uc794\uc5ec \uc870\uac01 \uc911 \ubb34\uc5c7\uc778\uc9c0 \uc54c \uc218 \uc5c6\uace0 `\uacfc\ud559` \ud45c\uc81c\ub3c4 \ube44\uc5b4 \uc788\ub2e4. \uc774\ub97c 388\uc758 \uacfc\ud559\uc801 \ud45c\uae30\ub77c\uace0 \ub2e8\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uacc4\ucc28\uc218\uc5f4 \uc815\uc758\u00b7\uc608\u00b7\uc131\uc9c8 \uc804\ubc18\uc5d0\uc11c \uc218\uc5f4 \uae30\ud638\uc640 \uc218\uc2dd \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4. \uc608\ub97c \ub4e4\uc5b4 `\uc218\uc5f4` \ub2e4\uc74c \uc785\ub825, \uc77c\ubc18\ud56d, \ub2e8\uc870\uc131\uc758 \ud544\uc694\ucda9\ubd84\uc870\uac74, \uace0\uacc4 \ub4f1\ucc28\uc218\uc5f4\uc758 \ucc28\uc218 \ud45c\uae30\uac00 \ub204\ub77d\ub418\uc5b4 \uc218\ud559\uc801 \uad00\uacc4\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4. \ucc38\uace0 \ud56d\ubaa9\uacfc \ubaa9\ub85d\uc740 \ubcf4\uc874\ud558\ub418 \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "Basic VML Types\ub77c\ub294 \uc8fc\uc81c\uc640 \uc5ec\ub7ec \uc124\uba85\uc740 \uc77d\ud788\uc9c0\ub9cc \uc720\ud615\ud45c\uc640 \uc0c9\uc0c1 \ud1a0\ud070 \ud45c\uc758 \ud544\ub4dc \uc5f0\uacb0\uc774 \ube44\uace0 \uc218\uc2dd\u00b7\ud0dc\uadf8 \uacbd\uacc4\uac00 \uc190\uc0c1\ub418\uc5b4 \ud575\uc2ec \uc815\uc758\ub97c \uc548\uc804\ud558\uac8c \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4. \uc548\uc804\ud55c \uc644\uacb0 \ubcf8\ubb38 \uacbd\uacc4\ub97c \uc7a1\uae30 \uc5b4\ub824\uc6cc \uc804\uccb4 \ubcf4\ub958\ud558\uace0 \uc608\uc2dc\ub97c hold \ud30c\uc77c\uc5d0 \uc801\uc5c8\ub2e4.": 1, "\ubc18\uc751\ud615 \uae00\uc790 \ud06c\uae30\uc5d0 \ub300\ud55c \uc124\uba85\uc740 \ub3c5\ub9bd\ub41c \uae30\uc220 \uae00\uc774\uc9c0\ub9cc, \u201c\ucf54\ub4dc\ub294 \ub2e4\uc74c\uacfc \uac19\ub2e4\u201d, \u201c\uc774 \ud568\uc218\u201d, \u201c\ub610 \ub2e4\ub978 \uc608\u201d, \u201c\uc815\ub9ac\ud558\uba74\u201d \ub4a4\uc5d0 \uc124\uba85\uc774 \uac00\ub9ac\ud0a4\ub294 \ucf54\ub4dc \uc608\uc81c\uac00 \uc5c6\ub2e4. \ub204\ub77d\ub41c Sass/CSS \uc608\uc81c\ub97c \uc0dd\uc131\ud560 \uc218 \uc5c6\uace0, \uadf8 \ubb38\uc7a5\ub4e4\uc744 \uc0ad\uc81c\ud558\uba74 \uc124\uba85 \uad00\uacc4\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\ub2e4. \uad00\ub828 \uc218\uce58\u00b7\ub2e8\uc704\u00b7HTML \uc694\uc18c\u00b7\uc6a9\uc5b4\ub294 \ubcf4\uc874\ud558\uace0 \ub204\ub77d \uad6c\uac04\ub9cc \ubcf4\ub958\ud55c\ub2e4.": 1, "\uc81c\ubaa9\uacfc 2010~2012 \uc5f0\ub3c4 \ud45c\uc81c, \uad00\ub828 \ub9c1\ud06c\ub9cc \uc788\uace0 \uc870\uc120\ubbfc\uc8fc\uc8fc\uc758\uc778\ubbfc\uacf5\ud654\uad6d \ucd95\uad6c \uad6d\uac00\ub300\ud45c\ud300 \uacbd\uae30 \uacb0\uacfc\uac00 \uc5c6\ub2e4. \ub9c1\ud06c\ub9cc\uc73c\ub85c \uacb0\uacfc\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\ub2e4.": 1, "\uc218\ud559 \uc18c\uac1c\u00b7\uc2dc\ud5d8\u00b7ACCA \ud64d\ubcf4\uc131 \ubb38\uad6c\uac00 \ud55c \ubb38\uc7a5 \ud750\ub984 \uc548\uc5d0 \uc11e\uc774\uace0 \uc22b\uc790\uc640 \ub17c\uc9c0\uc758 \uacbd\uacc4\uac00 \ub04a\uaca8 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud560 \uc218 \uc5c6\uc74c.": 1, "K\ud31d\uc2a4\ud0c0 \ubc29\uc1a1 \uacb0\uacfc \ud45c\uc758 \uc704\ud0a4 \ud14c\uc774\ube14 \uad6c\uc870\uac00 \uae68\uc838 \uc788\ub2e4. \ud2b9\ud788 \ud328\uc790\ubd80\ud65c\uc804 \ubd80\ubd84\uc758 `\uc0dd\ubc29\uc1a1 \uc9c4\ucd9c|-` \ub4f1 \ud589 \uacbd\uacc4\uac00 \ubd99\uc5b4 \uc788\uace0, \uc5f4\ubcc4 \uacb0\uacfc\u00b7\ud2b9\uc774\uc0ac\ud56d \uc140 \uad00\uacc4\uac00 \ubd88\uba85\ud655\ud558\ub2e4. \ud45c\uc758 \ud589\u00b7\uc774\ub984\u00b7\uace1\u00b7\uc18c\uc18d\uc0ac\u00b7\uc21c\uc704\ub97c \uc7ac\ubc30\uce58\ud558\uac70\ub098 \uace0\uce58\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\ubcc0 \uc124\uba85\uacfc \uc218\uce58\ub294 \ubcf4\uc874\ud55c\ub2e4.": 1, "\ub85c\uadf8\ub7ad\ud06c \uac80\uc815 \uc124\uba85\uc740 \uc8fc\uc81c\uac00 \uba85\ud655\ud558\uc9c0\ub9cc, \uc704\ud5d8\uc9d1\ub2e8\u00b7\uc0ac\uac74 \uc218\uc758 \uae30\ud638, \uae30\ub313\uac12\u00b7\ubd84\uc0b0, \uac80\uc815\ud1b5\uacc4\ub7c9, \uc815\uaddc\uadfc\uc0ac\uc640 \ud45c\ubcf8\uc218 \uacc4\uc0b0\uc758 \ud575\uc2ec \uc218\uc2dd \uc790\ub9ac\uac00 \ub2e4\uc218 \ube44\uc5b4 \uc788\ub2e4. \uc11c\uc9c0\uc640 \uac1c\ub150 \uc124\uba85\uc740 \ub530\ub85c \ubcf4\uc874\ud560 \uc218 \uc788\uc73c\ub098 \uc218\uc2dd\uc758 \uad00\uacc4\ub97c \ubcf5\uad6c\ud55c \uc644\uacb0 \ud1b5\uacc4 \uc124\uba85\uc73c\ub85c \ucde8\uae09\ud560 \uc218 \uc5c6\ub2e4. \uc218\uc2dd\uc740 \ucd94\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uc6d0\ubb38 \uc804\uccb4\uac00 ParaPro \ud50c\ub798\uc2dc\uce74\ub4dc \uc11c\ube44\uc2a4 \ud64d\ubcf4\u00b7\uac00\uc785/\ub2e4\uc6b4\ub85c\ub4dc \uc548\ub0b4\u00b7\ud6c4\uae30 \uc694\uccad\uc774\ub2e4. \uc2e4\uc81c \ud559\uc2b5 \uce74\ub4dc\u00b7\uc138\ud2b8\u00b7\ubb38\ud56d\u00b7\ub2f5\ubcc0\uc774 \uc5c6\uc5b4 \uad50\uc721 \ubcf8\ubb38\uc73c\ub85c \uc62c\ub9b4 \ub3c5\ub9bd\uc801\uc778 \ud559\uc2b5 \ub0b4\uc6a9\uc774 \uc5c6\ub2e4. \uc6d0\ubb38 \uc804\uccb4\ub97c \ubcf4\ub958 \uae30\ub85d\uc5d0 \uadf8\ub300\ub85c \ubcf4\uc874\ud588\ub2e4.": 1, "\ube48 `External links` \ud45c\uc81c\ub97c \uc81c\uac70\ud55c \ubcc0\uacbd \uc790\uccb4\ub294 \uc548\uc804\ud558\ub2e4. \ub2e4\ub9cc \ubcf8\ubb38 `electron densities \u2013 cm and pressures \u2013 K cm`\uc5d0\uc11c \ubc00\ub3c4\u00b7\uc555\ub825 \ud45c\ud604\uc774 \ube44\uc5b4 \uc788\uc5b4 \ubb3c\ub9ac \uc124\uba85\uc774 \uc190\uc0c1\ub3fc \uc788\ub2e4. \uc5c6\ub294 \uc2dd\u00b7\uac12\uc740 \ucd94\uc815\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc774 \uc190\uc0c1 \uad6c\uac04\uc744 \ubcf4\ub958\ud55c\ub2e4. \uc815\uc0c1 \uc11c\uc9c0 \ud56d\ubaa9\uc740 \uc804\ubd80 \ubcf4\uc874\ud55c\ub2e4.": 1, "\uc774 \uc790\ub8cc\ub294 \uc11c\ub85c \ub2e4\ub978 \ubc88\ud638 \uccb4\uacc4\ub85c \ub2e4\uc2dc \uc2dc\uc791\ud558\ub294 \uc6b4\uc728\u00b7\ud589\ubcc4 \ud559\uc220 \uc8fc\uc11d\ub9cc \ub2f4\uace0 \uc788\ub2e4. `this masque`, `this line`, `the manuscript` \ub4f1\uc740 \uc774\ub984\uacfc \uc6d0\ubb38 \uad6c\uc808\uc774 \uc5c6\ub294 \ub2e4\ub978 \ubb38\uc11c\uc5d0 \uc758\uc874\ud558\uba70, \ub450 \ubc88\uc9f8 `1 - 6` \ubb36\uc74c\ub3c4 \uc5b4\ub290 \uc791\ud488\uc778\uc9c0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc81c\ubaa9 \ubd80\uc7ac\ub9cc\uc774 \uc544\ub2c8\ub77c \uc8fc\uc11d\uc774 \ubd99\uc744 \uc6d0\ubb38\u00b7\uc791\ud488 \uacbd\uacc4\uac00 \uc190\uc2e4\ub418\uc5b4 \ub3c5\ub9bd\uc801\uc73c\ub85c \uadc0\uc18d\ud560 \uc218 \uc5c6\ub2e4. \uc8fc\uc11d\u00b7\uc6b4\uc728\u00b7\uc778\uc6a9 \uc790\uccb4\ub97c \ubc84\ub9ac\uc9c0 \ub9d0\uace0 \uc6d0\ubb38 \ub9e5\ub77d\uc744 \ud655\uc778\ud560 \ub54c\uae4c\uc9c0 \ubcf4\ub958\ud55c\ub2e4.": 1, "\uc778\ud130\ub137\u00b7\uac8c\uc784\u00b7\ud559\uc5c5 \uc131\uacfc\uc5d0 \uad00\ud55c \uc11c\ub85c \ub2e4\ub978 \ubb38\ub2e8, \ub04a\uae34 \uc778\uc6a9, \ucd9c\ucc98\u00b7\uc800\uc790 \uc815\ubcf4\uc640 \uc2ac\ub77c\uc774\ub4dc UI\uac00 \uc11e\uc600\ub2e4. \uc8fc\uc7a5\uacfc \uc778\uc6a9 \uc8fc\uccb4\uc758 \uacbd\uacc4\uac00 \uc18c\uc2e4\ub418\uc5b4 \ub3c5\ub9bd \ubb38\uc7a5\uc744 \uc548\uc804\ud558\uac8c \ubd84\ub9ac\ud558\uae30 \uc5b4\ub835\ub2e4.": 1, "\ube14\ub85c\uadf8 \uc544\uce74\uc774\ube0c\uc5d0\uc11c \uc5ec\ub7ec \uae00 \uc870\uac01\uacfc Tag Archives\u00b7\ub313\uae00\u00b7\ud0dc\uadf8\uac00 \uad50\ucc28\ud55c\ub2e4. \uc81c\ubaa9\u00b7\uac8c\uc2dc\ubb3c \uacbd\uacc4\uac00 \ubd80\uc871\ud574 \uac1c\ubcc4 \uae00\ub85c \uc790\ub974\uba74 \uc778\uc6a9\u00b7\uacac\ud574 \uadc0\uc18d\uc744 \ucd94\uc815\ud558\uac8c \ub418\uc5b4 \uc0c8 \ubcf8\ubb38\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 1, "OBSERVED_PAGE_WIDGET_REQUIRES_CONTEXT_EDIT": 43, "\ud574\ube59\u00b7\uadf8\ub9b0\ub780\ub4dc \uc721\ube59\u00b7\ub2ec \ud06c\uae30 \ubc14\uc704 \uad00\ub828 \uc124\uba85\uc740 \uc77c\ubd80 \ub0a8\uc9c0\ub9cc \uc9c8\ubb38 \ub300\uc0c1\uacfc \uc55e\ub4a4 \ubb38\ub9e5\uc774 \uc5c6\ub2e4. PerlMonks \uac8c\uc2dc \uc548\ub0b4\u00b7HTML \uc9c0\uce68\uacfc \ud0d0\uc0c9 UI\ub3c4 \ubcf8\ubb38\uc5d0 \uc11e\uc5ec \uc788\ub2e4. \ub2f5\ubcc0 \ubc94\uc704\uc640 UI \uc81c\uac70\uc120\uc744 \ud14d\uc2a4\ud2b8\ub9cc\uc73c\ub85c \ud655\uc815\ud558\uae30 \uc5b4\ub835\ub2e4.": 1, "\uae30\uc0ac \uacbd\uacc4\uc640 \ubb38\uc7a5 \uc5f0\uacb0\uc774 \uc190\uc0c1\ub41c \uc0c1\ud0dc\uc5d0 \uc0dd\ubb3c\ubb34\uae30 \uc900\ube44\u00b7\ud655\uc0b0\uc758 \uc815\ub7c9 \uae30\uc220 \ub0b4\uc6a9\uc774 \uc11e\uc5ec \uc788\ub2e4. \ub3c5\ub9bd \ubcf8\ubb38\uc744 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc558\uace0 \uc0c8 \ubcf8\ubb38\uc774\ub098 \ubcf5\uc0ac \ubd80\ub85d\ub3c4 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4.": 1, "\ud558\uc774\ud401 \uc5ed\uc774 1910\ub144\uc5d0 \ud611\uada4\uc5ed\uc73c\ub85c \uac1c\uc5c5\ud588\ub2e4\ub294 \uc18c\uac1c\uc640, 1902\ub144 6\uc6d4 16\uc77c \ucca0\ub3c4 \uc644\uacf5 \ubc0f \uc5ed \uac1c\uc5c5\uc774\ub77c\ub294 \uc5f0\ud601\uc774 \ud568\uaed8 \uc788\uc5b4 \ub0a0\uc9dc\uac00 \ucda9\ub3cc\ud55c\ub2e4. source SHA \ubc0f \uc678\ubd80 \uc790\ub8cc\ub97c \ud655\uc778\ud560 \uc218 \uc5c6\uace0 \uc804\ud6c4 \uc5ed \uc808\ub3c4 \ube44\uc5b4 \uc788\uc5b4 \ucda9\ub3cc\uc744 \uc784\uc758\ub85c \uc815\uaddc\ud654\ud558\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uc5ec\ub7ec \uc9e7\uc740 \ub300\uc0ac\u00b7\uc81c\ubaa9\uacfc \uac01 `Tags:` \ud56d\ubaa9\uc774 \uc774\uc5b4\uc9c0\uc9c0\ub9cc, \uadf8\uac83\ub4e4\uc774 \uc5b4\ub5a4 \uc791\ud488\u00b7\uc0c1\ud669\uc5d0 \uc18d\ud558\ub294\uc9c0 \ubcf8\ubb38\uc5d0\uc11c \uc2dd\ubcc4\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38\uacfc \uc81c\uc548\ubb38\uc740 \uac19\uace0 \uc0ad\uc81c \uc190\uc2e4\uc740 \uc5c6\uc73c\ub098, \uc804\uccb4\ub97c \ub3c5\ub9bd\uc801\uc778 \uc0b0\ubb38\uc73c\ub85c \ud655\uc815\ud560 \uadfc\uac70\ub3c4 \uc5c6\ub2e4. \ub300\uc0ac\u00b7\ud0dc\uadf8\ub97c \uc784\uc758\ub85c \uc9dd\uc9d3\uac70\ub098 \ubb38\ub9e5\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4.": 1, "\uad00\uacc4 \ub300\uc218\uc758 \ud575\uc2ec \uae30\ud638\u00b7\uc815\uc758\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \uc18c\uc2e4\ub418\uace0 SQL \uc608\ub9cc\uc73c\ub85c \uc6d0\ub798 \uad00\uacc4\ub97c \ubcf5\uad6c\ud560 \uadfc\uac70\uac00 \ubd80\uc871\ud568. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "\ubcf8\ubb38\uc740 \ubd80\ub098 \uc0ac\ub974\uc758 \uc0dd\ub144\uc6d4\uc77c\uc744 1992\ub144 1\uc6d4 31\uc77c\ub85c \uc801\uc9c0\ub9cc \ubd84\ub958\uc5d0\ub294 1991\ub144 \ucd9c\uc0dd\uc774 \uc788\uc5b4 \ub0b4\ubd80 \uc5f0\ub3c4\uac00 \ucda9\ub3cc\ud55c\ub2e4. \uc678\ubd80 \ud655\uc778\uc774\ub098 \uc784\uc758 \uc815\uc815\uc744 \ud558\uc9c0 \uc54a\uc558\uc73c\ubbc0\ub85c \uc6d0\ubb38 \uadf8\ub300\ub85c KEEP\ud558\ub294 \uc81c\uc548\uc744 \ubb34\uc870\uac74 \ud1b5\uacfc\uc2dc\ud0ac \uc218 \uc5c6\ub2e4.": 1, "\ud558\uae30\uc640\ub77c\uc815 \uc18c\uac1c\u00b7\uc9c0\ub9ac\u00b7\uc5ed\uc0ac\u00b7\ucca0\ub3c4\u00b7\ub3c4\ub85c \uc815\ubcf4\ub294 \ub300\ubd80\ubd84 \uc77d\ud788\uc9c0\ub9cc, \uc5ed\uc0ac \uc55e\uc758 \uc5f4\ub9b0 \ucf54\ub4dc \ud39c\uc2a4 \ud45c\uc2dd\uc774 \ub0a8\uc544 \uc788\uace0 \ud569\ubcd1\uc77c\uc774 \uc18c\uac1c\uc5d0\ub294 2004-04-01, \uc5ed\uc0ac\uc5d0\ub294 2004-03-01\ub85c \uc11c\ub85c \ub2e4\ub974\ub2e4. \ub450 \ub0a0\uc9dc\ub97c \ub2e8\uc77c \uac12\uc73c\ub85c \ubc14\uafb8\uac70\ub098 \uc5f4\ub9b0 \ud45c\uc2dd\uc744 \uc784\uc758 \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4.": 1, "\ube44\uad50\u00b7\ub300\uc870 \uae00\uc4f0\uae30 \uc548\ub0b4\ub294 \uc628\uc804\ud55c \ub3c5\ub9bd \ub2f5\ubcc0\uc774\ub2e4. \ub2e4\ub9cc \u201c~~~2A. detail 1\u201d \ub4f1 \uc904\uc740 \uac1c\uc694 \ud45c\uae30\ucc98\ub7fc \uc77d\ud788\ub294 \ub3d9\uc2dc\uc5d0 \ub2eb\ub294 \uc904\uc774 \uc5c6\ub294 \uc2e4\uc81c Markdown \ud39c\uc2a4 \uad6c\ubb38\uc774\ub2e4. \uc758\ub3c4\ub41c \ud45c\uae30\uc778\uc9c0 \uc190\uc0c1\ub41c \ud39c\uc2a4\uc778\uc9c0 \uc6d0\ubb38\ub9cc\uc73c\ub85c \uc815\ud560 \uc218 \uc5c6\uc5b4 \uc0ad\uc81c\u00b7\uc7ac\ubc30\uce58\u00b7\uc885\uacb0\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub05d\uc758 \ubbf8\uad6d\uc0ac \uc9c8\ubb38 \ubaa9\ub85d\ub3c4 \uacbd\uacc4 \ud45c\uc81c\uac00 \uc5c6\uc5b4 \uad00\ub828\ubb38\ud56d\uc778\uc9c0 \ubcc4\ub3c4 UI\uc778\uc9c0 \ubd88\ud655\uc815\uc774\ub2e4. \uc55e\uc758 \uc548\ub0b4\ubb38\uc740 \ub3c5\ub9bd \ubcf4\uc874 \uac00\ub2a5\ud558\ub2e4.": 1, "\uacbd\ub9e4/\ud310\ub9e4 \ud56d\ubaa9\uc5d0 \uc2e0\ubb38 \ubc1c\ucdcc, \uc0dd\ub7b5\ubd80\ud638, \ud310\ub9e4 \uc124\uba85, \uc885\uc774 \uc0c1\ud0dc\uac00 \uc11e\uc5ec \uc6d0\uc2e0\ubb38 \ub3c5\ub9bd \ubcf8\ubb38\uacfc \uc778\uc6a9 \uacbd\uacc4\ub97c \uad6c\ubd84\ud560 \uc218 \uc5c6\ub2e4. \ub0a0\uc9dc\u00b7\ud56d\ubaa9\ubc88\ud638\u00b7\uc778\uc6a9\uc740 \ubcf5\uc6d0\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "DFT\u00b7FFT, Blackman/Hann \ucc3d, \uc0c1\uad00\u00b7PSD\u00b7coherence \uad00\ub828 \ubcf8\ubb38\uacfc Matlab/Octave \ucf54\ub4dc \ubc0f \uc11c\uc9c0\ub294 \uc0c1\ub2f9 \ubd80\ubd84 \ubcf4\uc874\ub3fc \uc788\uc73c\ub098 \uc815\uc758\uc2dd\u00b7\ubcc0\uc218\u00b7\uc218\uce58\uac00 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube60\uc838 \ub4a4 \ubb38\uc7a5\uc774 \ube48 \uae30\ud638\ub97c \ucc38\uc870\ud55c\ub2e4. \ud398\uc774\uc9c0\u00b7\uadf8\ub9bc\uc744 \ubcf4\uc9c0 \uc54a\uace0 \uc218\uc2dd\uc774\ub098 \uc870\uac74\uc744 \ubcf5\uc6d0\ud560 \uc218 \uc5c6\uc5b4 \uc7a5 \uc804\uccb4\ub97c \uc815\uc0c1 \uae30\uc220 \uc124\uba85\uc73c\ub85c \ucc44\ud0dd\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc77d\uae30\ub9cc \ud588\uace0 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uc21c\ud658\uad70\uc758 \uc704\uc218 \uc124\uba85\uacfc \uc99d\uba85\uc5d0 \ud544\uc694\ud55c \uc218\uc2dd\u00b7\ub4f1\uc2dd\uc774 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ube44\uc5b4 \uc788\ub2e4. \ube60\uc9c4 \ud45c\ud604 \uc5c6\uc774 \ub17c\uc99d\uc744 \ubcf5\uad6c\ud560 \uc218 \uc5c6\uc5b4 HOLD\ud55c\ub2e4.": 1, "Tashi Thinles \ud45c\uae30 \ub4a4 \uc11c\ub85c \ub2e4\ub978 \ubc94\uc704\uc77c \uc218 \uc788\ub294 \uace0\ub3c4\u00b7\uc751\uae09\ucc98\uce58\u00b7\uc800\uccb4\uc628 \uc548\ub0b4\uac00 \uc774\uc5b4\uc9c0\uace0, \uc810\uc218\ud45c\uc640 \uc0dd\uc874\uc2dc\uac04 \ud45c\uc758 \ud589 \uc5f0\uacb0\uc774 \ube60\uc838 \uc788\ub2e4. \uc0c1\uc2b9 \uad8c\uace0 \ub450 \ubb38\uc7a5\uc740 \uc870\uac74\uc774 \ub2e4\ub97c \uc218\ub3c4 \uc788\uc5b4 \ud558\ub098\ub97c \uace0\ub974\uc9c0 \uc54a\uc558\ub2e4. \uc758\ud559\uc801 \uc0ac\uc2e4 \uac80\uc99d\uc774\ub098 \uc218\uce58 \ubcf5\uad6c\ub294 \ud558\uc9c0 \uc54a\uc558\ub2e4.": 1, "\uae08\uc735 \ubb38\ud56d \ubaa9\ub85d\uc73c\ub85c \uc2dd\ubcc4\ub418\ubbc0\ub85c \ubc18\ubcf5 \uac00\ub2a5\uc131\ub9cc\uc73c\ub85c \uc804\uccb4\ub97c \ubcf4\ub958\ud560 \uc774\uc720\ub294 \uc5c6\ub2e4. \ub2e4\ub9cc \ubb38\ud56d `10`\uc740 `11.50%,`\uc5d0\uc11c \ub05d\ub098\uace0, `13`\uc740 \uc81c\uc2dc\ub418\uc9c0 \uc54a\uc740 I\u2013IV\ub97c \uac00\ub9ac\ud0a4\uba70, `17`\uc740 `equal to` \ub4a4 \ubaa9\uc801\uc5b4\uac00 \uc5c6\ub2e4. \uc120\ud0dd\uc9c0\uac00 \uc77c\ubd80\ub9cc \ubcf4\uc774\ub294 \ubb38\ud56d\ub3c4 \uc788\ub2e4. \ubb38\ud56d \ubc88\ud638\u00b7\uae08\uc561\u00b7\uc774\uc728\u00b7\uc788\ub294 \uc120\ud0dd\uc9c0\ub97c \ubcf4\uc874\ud558\ub418 \ub204\ub77d \ubb38\ud56d\uc774\ub098 \uc815\ub2f5\uc744 \ub9cc\ub4e4 \uc218 \uc5c6\ub2e4.": 1, "\uc911\uc559\uac12 \ubb38\uc81c\uc758 \uc785\ub825 \uc218 \uc815\uc758\uc640 \uc815\uc218 \uc810\uc218 \uc790\ub9ac\uac00 \ube44\uace0 \ub450 \uc0d8\ud50c \ucd9c\ub825\ub3c4 \uc5c6\uc74c. \ub313\uae00\uc740 \ubc18\uc62c\ub9bc \uc870\uc5b8\uc774 \uc11c\ub85c \ub2e4\ub974\uace0 \ub3c5\ub9bd \ubb38\ub9e5\uc774 \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc544 \ubd80\ubd84 \ubcf5\uad6c\ud558\uc9c0 \uc54a\uc74c. \ucd1d\uad04 \ud310\uc815 \ubc18\uc601.": 1, "Java \uacfc\uc81c \ub3c4\uc6c0 \uc694\uccad\uacfc \ubd88\uc644\uc804\ud55c \ucf54\ub4dc \uc870\uac01\ub9cc \uc788\ub2e4. \uc124\uba85\u00b7\ud574\uacb0 \uacfc\uc815\uc774 \uc5c6\uc5b4 \ub3c5\ub9bd \ub2f5\ubcc0 \ubcf8\ubb38\uc73c\ub85c \ubcf5\uad6c\ud560 \uc218 \uc5c6\ub2e4. \ucf54\ub4dc\ub294 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.": 1}, "sources": {"validation": 972, "expanded_train": 296659, "historical_train": 163064}, "unique_language": {"HAS_HANGUL": 262239, "NO_HANGUL": 35300}, "occurrence_language": {"HAS_HANGUL": 409053, "NO_HANGUL": 51642}, "manual_hold_unique": 33, "full_residual_coverage": true, "resolved": 0, "unprocessed": 460695, "training_authorized": false, "seconds": 95.49231193901505}
