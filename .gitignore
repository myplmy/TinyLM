# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.env
.venv/

# ── 대용량·재생성 가능 학습 산출물 ─────────────────────
# 토큰 바이너리·체크포인트는 커밋하지 않는다(재생성 가능, 수백 MB~GB).
runs/
**/run100m/ckpt/
**/run100m/data/
**/data_cache/
*.pt
*.bin

# ── Hugging Face 로컬 캐시(모델·데이터셋) ───────────────
HF/

# ── Wandb logs ───────────────
wandb/

# ── 로그(logs/*.json)는 추적한다 — 실험 기록이므로 무시하지 않음 ──

# ── scratch ─────────────────────────────────────────────
tmp/
*.tmp

# ── TinyDataset 작업 스크립트 ────────────────────────────
# 2026-08-30 사용자 지시 — `datasets/TinyDataset/` 아래의 python 은 **다른 AI 모델이
# 데이터셋을 만드는 동안 임시로 쓰는 것**이고 우리 코드가 아니다.
# 우리 정본 코드는 `tinylm/` 과 `scripts/` 뿐이므로 여기 것은 추적하지 않는다.
# ⚠️데이터(.json/.jsonl)는 **추적한다** — 그것이 산출물이다.
datasets/TinyDataset/**/*.py

# ── TinyDataset 정본 감사기 allowlist ────────────────────
!datasets/TinyDataset/stage1_highdensity_dataset/tools/stage2_10_corpus_common.py
!datasets/TinyDataset/stage2_highdensity_dataset/tools/audit_stage2_a03_train_full.py
!datasets/TinyDataset/stage2_highdensity_dataset/tools/verify_stage2_similarity_sklearn.py
!datasets/TinyDataset/stage2_highdensity_dataset/tools/reaudit_stage2_a01_train.py

# ★런 레지스트리 DB 캐시 — 정본은 runs/registry.tsv (2026-09-05)
runs/registry.db

# ── ClaudeCode_세션작업기록 ───────────────
ai_dev_tool/temp_claude_중단세션/**

# ── Codex environment ───────────────
.codex/environments/

# Experiment evidence: bounded decision records may be tracked selectively.
# Bulk/temporary/private diagnostics remain local; never move old evidence here automatically.
/test_result/evidence/local/
/test_result/evidence/_local/
/test_result/evidence/**/cache/
/test_result/evidence/**/*.npy
/test_result/evidence/**/*.npz
/test_result/evidence/**/*.safetensors
/test_result/evidence/**/*.gguf
/test_result/evidence/**/*.parquet
/test_result/evidence/**/*.arrow
/test_result/evidence/**/*.pkl
/test_result/evidence/**/*.pickle
/test_result/evidence/**/*.sqlite
/test_result/evidence/**/*.sqlite3
/test_result/evidence/**/*.db
/test_result/evidence/**/*.zip
/test_result/evidence/**/*.gz
/test_result/evidence/**/*.zst

# Session runtime capsules are local, potentially stale recovery state, not final evidence.
/handoff/audit/*_RUNTIME_CAPSULE.json
