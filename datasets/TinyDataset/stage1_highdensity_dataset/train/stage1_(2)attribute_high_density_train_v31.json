  "records": [
    {"id":"S1-ATH-4501","type":"attribute_packet","split":"train","text":"결과가 나온 이유를 사람이 이해할 수 있는 근거로 제시해 판단근거설명가능성이 높다. 정확도 자체와는 다른 속성이다.","concepts":["판단근거설명가능성"],"relations":["attribute","is_a","boundary"]},
