    "other_records": [
      {
        "id": "S1-ATV-0011",
        "concept": "토양뿌리관입저항성",
        "text": "뿌리 끝이 흙을 밀어내며 내려갈 때 받는 기계적 저항이 크면 뿌리관입이 제한된다. 수분 부족의 영향과 구분해 측정한다."
      },
      {
        "id": "S1-ATV-0029",
        "concept": "표면유출집중도",
        "text": "넓은 사면의 물이 몇 개의 작은 통로에 몰려 흐르면 표면유출집중도가 높다. 총유출량과는 다른 정보다."
      },
      {
        "id": "S1-ATV-0043",
        "concept": "낙석발생잠재력",
        "text": "느슨한 암괴의 크기와 지지 상태, 경사를 함께 고려해 앞으로 떨어질 가능성을 낙석발생잠재력으로 나타낸다."
      },
      {
        "id": "S1-ATV-0053",
        "concept": "층리방향의존강도",
        "text": "하중이 층리와 나란할 때와 수직일 때 암석 강도가 크게 다르면 층리방향의존강도가 높다."
      },
      {
        "id": "S1-ATV-0056",
        "concept": "모암성분영향도",
        "text": "모암의 광물 조성이 만들어진 토양의 산도와 입도에 미치는 영향의 크기를 모암성분영향도로 나타낸다."
      },
      {
        "id": "S1-ATV-0072",
        "concept": "하구퇴적혼합성",
        "text": "강에서 온 모래와 바다에서 온 진흙이 층을 나누지 않고 섞여 쌓이는 정도가 하구퇴적혼합성이다."
      },
      {
        "id": "S1-ATV-0085",
        "concept": "지표요철배수영향도",
        "text": "작은 표면 굴곡이 빗물의 고임과 흐름 방향을 바꾸는 정도를 지표요철배수영향도로 본다."
      },
      {
        "id": "S1-ATV-0105",
        "concept": "함양지표피복의존성",
        "text": "같은 비에도 숲, 포장면, 밭에서 지하수 함양량이 크게 다르면 함양지표피복의존성이 높다."
      },
      {
        "id": "S1-ATV-0115",
        "concept": "습지식생수리저항성",
        "text": "줄기와 잎이 흐름을 늦추고 수위를 높이는 정도가 습지식생수리저항성이다. 식생 밀도와 동일한 값은 아니다."
      },
      {
        "id": "S1-ATV-0125",
        "concept": "싱크홀형성잠재력",
        "text": "지하 공동의 크기와 덮개층 강도를 함께 고려해 지표 함몰 가능성을 싱크홀형성잠재력으로 나타낸다."
      },
      {
        "id": "S1-ATV-0128",
        "concept": "지진동증폭지형의존성",
        "text": "관측 지형을 능선형과 분지형 상태로 분류했을 때 같은 지진파의 흔들림이 유형별로 크게 달라지는 현상을 지진동증폭지형의존성이라 한다."
      },
      {
        "id": "S1-ATV-0133",
        "concept": "지표변위공간집중성",
        "text": "넓은 지역의 변위가 몇 개 균열대에 몰려 나타나면 지표변위공간집중성이 높다."
      },
      {
        "id": "S1-ATV-0134",
        "concept": "기반암심도불확실성",
        "text": "시추공 사이에서 기반암 높이를 정확히 잇기 어려운 정도가 기반암심도불확실성이다. 평균 깊이와는 별개다."
      },
      {
        "id": "S1-ATV-0148",
        "concept": "유출계수지역의존성",
        "text": "같은 강우에서도 토지 피복과 토양이 다른 유역의 유출계수가 크게 달라지면 지역의존성이 높다."
      },
      {
        "id": "S1-ATV-0150",
        "concept": "수문모형초기조건의존성",
        "text": "모의 시작 수분과 수위를 조금 다르게 주었을 때 홍수 예측이 크게 달라지면 초기조건의존성이 높다."
      },
      {
        "id": "S1-ATV-0172",
        "concept": "수분증발집중성",
        "text": "가열 중 수분 손실이 전체 표면이 아니라 얇은 가장자리나 균열에 몰리면 수분증발집중성이 높다."
      },
      {
        "id": "S1-ATV-0180",
        "concept": "화력분포의존성",
        "text": "같은 조리법도 버너 중앙과 가장자리의 열 분포에 따라 익힘 편차가 크게 달라지면 화력분포의존성이 높다."
      },
      {
        "id": "S1-ATV-0186",
        "concept": "다공질과자붕괴상태",
        "text": "다공질 과자가 침과 압력을 받아 부서지는 양상을 즉시 붕괴와 지연 붕괴 상태로 나누고, 구조 유지 기능과 함께 기록한다."
      },
      {
        "id": "S1-ATV-0193",
        "concept": "섬유질잔존감",
        "text": "삼킨 뒤에도 입안에 남아 느껴지는 식물성 섬유 조각의 정도가 섬유질잔존감이다. 실제 총식이섬유 함량과 같지 않다."
      },
      {
        "id": "S1-ATV-0210",
        "concept": "향미복합도",
        "text": "서로 구별되는 맛과 향의 층이 동시에 느껴지는 정도를 향미복합도라 한다. 단순히 향이 강하다는 뜻은 아니다."
      },
      {
        "id": "S1-ATV-0240",
        "concept": "혼합순서의존성",
        "text": "같은 재료라도 넣는 순서에 따라 유화나 반죽 구조가 크게 달라지면 혼합순서의존성이 높다."
      },
      {
        "id": "S1-ATV-0250",
        "concept": "저장등급기능상태",
        "text": "제품의 보존 기능이 유지되는지를 정상, 주의, 상실 상태로 분류하고 현재 품질값과 함께 기록한다."
      },
      {
        "id": "S1-ATV-0251",
        "concept": "온도이탈누적영향도",
        "text": "냉장 범위를 벗어난 온도와 지속 시간이 쌓여 품질 저하에 미치는 영향을 온도이탈누적영향도로 나타낸다."
      },
      {
        "id": "S1-ATV-0285",
        "concept": "포장재향이행도",
        "text": "포장 재료의 냄새 성분이 식품으로 옮겨가 감지되는 정도를 포장재향이행도로 나타낸다."
      },
      {
        "id": "S1-ATV-0288",
        "concept": "점도측정전단의존성",
        "text": "회전 속도를 바꿀 때 측정 점도가 크게 달라지면 점도측정전단의존성이 높다."
      },
      {
        "id": "S1-ATV-0314",
        "concept": "차양깊이일사의존성",
        "text": "같은 창에서도 차양 돌출 깊이에 따라 들어오는 직달 일사가 크게 바뀌면 차양깊이일사의존성이 높다."
      },
      {
        "id": "S1-ATV-0336",
        "concept": "차양제어상태분류",
        "text": "외부 밝기와 눈부심에 따라 차양을 개방, 부분 차폐, 완전 차폐 상태로 나누고 시야 유지 기능도 함께 평가한다."
      },
      {
        "id": "S1-ATV-0340",
        "concept": "유리투과색편향성",
        "text": "유리를 통과한 빛이 중성광보다 특정 색조로 치우치는 정도가 유리투과색편향성이다."
      },
      {
        "id": "S1-ATV-0351",
        "concept": "흡음재주파수선택성",
        "text": "흡음재가 모든 소리보다 특정 주파수 대역을 더 많이 줄이면 주파수선택성이 높다."
      },
      {
        "id": "S1-ATV-0369",
        "concept": "창문환기바람의존성",
        "text": "창 개방 면적이 같아도 외부 풍향과 속도에 따라 환기량이 크게 달라지면 바람의존성이 높다."
      },
      {
        "id": "S1-ATV-0387",
        "concept": "가구배치동선의존성",
        "text": "같은 면적에서도 가구의 방향과 간격에 따라 이동 거리가 크게 달라지면 동선의존성이 높다."
      },
      {
        "id": "S1-ATV-0413",
        "concept": "냉방부하피크집중성",
        "text": "하루 냉방 에너지 요구가 짧은 오후 시간대에 몰리면 피크집중성이 높다."
      },
      {
        "id": "S1-ATV-0422",
        "concept": "창개방행동온도의존성",
        "text": "실내 온도가 오를수록 사용자가 창을 여는 빈도가 크게 늘면 창개방행동온도의존성이 높다."
      },
      {
        "id": "S1-ATV-0429",
        "concept": "공동공간소음수용도",
        "text": "같은 소리 크기라도 대화 공간에서 이용자가 받아들일 수 있는 정도를 공동공간소음수용도라 한다."
      },
      {
        "id": "S1-ATV-0446",
        "concept": "센서결측공간집중성",
        "text": "누락된 측정값이 여러 장치에 고르게 생기지 않고 특정 층이나 구역에 몰리면 공간집중성이 높다."
      },
      {
        "id": "S1-ATV-0448",
        "concept": "설비효율추정불확실성",
        "text": "유량과 온도 측정 오차 때문에 계산한 설비 효율의 가능한 범위가 넓은 정도를 추정불확실성이라 한다."
      },
      {
        "id": "S1-ATV-0459",
        "concept": "용존유기물착색도",
        "text": "물에 녹은 유기물이 청색광을 흡수해 해수를 누렇게 보이게 하는 정도가 용존유기물착색도다."
      },
      {
        "id": "S1-ATV-0463",
        "concept": "해수전기전도온도의존성",
        "text": "염분이 같아도 온도에 따라 전기전도도가 크게 달라지면 온도의존성이 높다."
      },
      {
        "id": "S1-ATV-0467",
        "concept": "파주기분포집중도",
        "text": "관측된 파의 주기가 좁은 범위에 몰려 있으면 파주기분포집중도가 높다."
      },
      {
        "id": "S1-ATV-0472",
        "concept": "수로유속집중성",
        "text": "넓은 조간대의 흐름이 좁은 수로에 몰려 빨라지면 수로유속집중성이 높다."
      },
      {
        "id": "S1-ATV-0480",
        "concept": "파랑예측초기조건의존성",
        "text": "파랑 모형을 시작할 때 부여한 파고 분포와 바람장이 근소하게 달라져도 먼 시각의 파랑 예측이 벌어지면 초기조건의존성이 높다."
      },
      {
        "id": "S1-ATV-0485",
        "concept": "표사입경선택성",
        "text": "파도와 흐름이 모든 모래보다 특정 크기의 입자를 더 잘 옮기면 표사입경선택성이 높다."
      },
      {
        "id": "S1-ATV-0486",
        "concept": "퇴적지형상태분류",
        "text": "사주와 갯벌 표면을 성장, 평형, 침식 상태로 나누고 퇴적물 이동 기능이 어떻게 달라지는지도 함께 기록한다."
