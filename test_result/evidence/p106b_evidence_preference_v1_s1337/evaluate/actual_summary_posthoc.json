  "calculation_source": "import json\nfrom pathlib import Path\np=Path('test_result/evidence/p106b_evidence_preference_v1_s1337/evaluate')\nr=json.loads((p/'report.json').read_text());paired=json.loads((p/'paired_readback.json').read_text())\ndef values(spec):\n root=Path(spec['directory']);out=[]\n for s in spec['manifest']['shards']:\n  out.extend(json.loads(x) for x in (root/s['path']).read_text().splitlines())\n return out\ndef stat(v):\n return dict(cases=len(v),literal=sum(x['scores']['literal'] for x in v),\n  empty=sum(x['scores']['empty'] for x in v),max_new=sum(x['scores']['max_new'] for x in v),context_exhausted=sum(x['scores']['context_exhausted'] for x in v))\nout={}\nfor arm,d in r['endpoints'].items():\n m=d['metrics'];e=[x for x in values(m['evidence_test']) if x['history']=='ACTUAL_MODEL']\n a=[x for x in e if x['expected_response_intent']=='ANSWER']\n ask=[x for x in e if x['expected_response_intent']=='ASK_FOR_MISSING_FACT']\n record=dict(scalar=stat(a),ask_exact_proxy=stat(ask),sufficient_first=stat([x for x in e if x['turn']==1 and x['first_query_sufficient']]),\n  after_supply=stat([x for x in e if x['turn']==2]),after_update=stat([x for x in e if x['turn']==3]),families={},\n  source=stat([x for x in values(m['source_posthoc_dev']) if x['history']=='ACTUAL_MODEL']),\n  role=stat([x for x in values(m['role_retention']) if x['history']=='ACTUAL_MODEL']),\n  fiction=stat([x for x in values(m['fiction_retention']) if x['history']=='ACTUAL_MODEL']),\n  native=m['native32crop'])\n for f in sorted({x['family'] for x in e}):record['families'][f]=stat([x for x in e if x['family']==f and x['expected_response_intent']=='ANSWER'])\n record['code']=dict(cases=sum(x['cases'] for x in m['code_development']['counts'].values()),correct=sum(x['code_exact'] for x in m['code_development']['counts'].values()));record['legacy8']={k:m['legacy8'][k] for k in ('first_attempt_pass','pass_within_three','questions','actual_attempts')}\n out[arm]=record\nprint(json.dumps(dict(status=r['status'],whole_sec=r['whole_sec'],arms=out,pairs={k:v['ANSWER'] for k,v in paired['pairs'].items()}),ensure_ascii=False,indent=2))\n"
