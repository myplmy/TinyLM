  "calculation_source": "import json,hashlib\nfrom pathlib import Path\nfrom scripts import diag_p106b_evidence_style as gate\nr=gate.course.producer.required(gate.EVIDENCE/'evaluate/report.json');inputs=gate.course.producer.required(gate.OUTPUT/'report.json')\ngate.verify(gate.OUTPUT,inputs['manifest'])\ncases=list(gate.course.training.data.stream_rows(gate.OUTPUT,inputs['manifest']))\ndata={};summaries={}\nfor arm,spec in r['endpoints'].items():\n directory=gate.ROOT/spec['directory'];gate.verify(directory,spec['manifest'])\n values=list(gate.course.training.data.stream_rows(directory,spec['manifest']))\n assert len(values)==64\n indexed={(v['root'],v['style']):v for v in values};assert len(indexed)==64\n counts=gate.summarize(values);assert counts==spec['counts']\n old=gate.course.producer.required(gate.prior.EVIDENCE/(arm+'_report.json'));ee=gate.prior.read_values(old['metrics']['evidence_test'])\n anchors={e['root']:e for e in ee if e['history']=='ACTUAL_MODEL' and e['turn']==1}\n for case in cases:gate.anchor_check(indexed[case['root'],3],anchors[case['root']])\n data[arm]=indexed;summaries[arm]=dict(counts=counts,exact_anchor_replays=32,peak_reserved_mib=spec['peak_reserved_mib'])\nout=[]\nfor c in cases:\n out.append(dict(family=c['family'],lang=c['language'],condition=c['condition'],sufficient=c['sufficient'],gold=c['gold'],\n   replies={a:[v[c['root'],s]['answer'] for s in (0,3)] for a,v in data.items()}))\nprint(json.dumps(dict(whole_sec=r['whole_sec'],summaries=summaries,cases=out),ensure_ascii=False))\n"
